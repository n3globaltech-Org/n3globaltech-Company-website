# N3 Global Tech website — Cloudflare server-side bindings
# Never prefix either variable with PUBLIC_. CRM_API_TOKEN must be configured
# as an encrypted Cloudflare secret and must never be used in browser code.

# Preferred explicit endpoint components:
CRM_API_BASE_URL=https://api.n3global.tech
CRM_WEBSITE_PUBLIC_ID=

# Backward-compatible full contact endpoint shown by N3Books Settings → Website Integrations:
# https://api.n3global.tech/api/website-enquiries/<PUBLIC_ID>
CRM_API_URL=

# One-time credential generated by N3Books (format: n3wi_<PUBLIC_ID>.<SECRET>).
# Rotate/revoke it in N3Books. Store it as a Cloudflare secret, not plain source.
CRM_API_TOKEN=
