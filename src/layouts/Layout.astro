---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';
import '@fontsource/geist-sans/800.css';
import '@fontsource/geist-sans/900.css';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  noindex?: boolean;
  lockViewportScale?: boolean;
  type?: 'website' | 'article';
  faqs?: { question: string; answer: string }[];
  article?: {
    headline: string;
    description: string;
    datePublished: string;
    dateModified?: string;
    image?: string;
    author?: string;
  };
  service?: {
    name: string;
    description: string;
    serviceType?: string;
  };
}

const {
  title,
  description = "N3 Global Tech is a custom software development company building scalable web apps, mobile apps, cloud platforms, AI solutions, and SaaS products for startups and enterprises worldwide.",
  keywords = "N3GlobalTech, n3global.tech, n3globaltech, software development company, web development, mobile app development, cloud solutions, SaaS development, custom software, AI development, UI UX design, MVP development, digital transformation, startup tech partner, CRM, ERP, Astro, React, Node.js",
  image = "/og-img.jpeg",
  noindex = false,
  lockViewportScale = false,
  type = 'website',
  faqs,
  article,
  service,
} = Astro.props;

const siteName = "N3 Global Tech";
const alternateSiteName = "N3GlobalTech";
const fullTitle = title.includes(siteName) || title.includes(alternateSiteName) ? title : `${title} | ${siteName} (${alternateSiteName})`;
const siteUrl = Astro.site ?? new URL("https://www.n3global.tech");
const canonicalPath = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : Astro.url.pathname + '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const siteUrlString = siteUrl.toString();

// Auto-generate breadcrumbs from URL path
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { name: 'Home', url: siteUrlString },
  ...pathSegments.map((seg, idx) => {
    const path = '/' + pathSegments.slice(0, idx + 1).join('/');
    const label = seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' ');
    return { name: label, url: new URL(path, siteUrl).href };
  }),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    name: item.name,
    item: item.url,
  })),
};

const faqSchema = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: { "@type": "Answer", text: f.answer },
  })),
} : null;

const articleSchema = article ? {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.headline,
  description: article.description,
  image: article.image ? new URL(article.image, siteUrl).href : ogImage,
  datePublished: article.datePublished,
  dateModified: article.dateModified ?? article.datePublished,
  author: {
    "@type": "Organization",
    name: article.author ?? "N3 Global Tech",
    url: siteUrlString,
  },
  publisher: { "@id": `${siteUrlString}#organization` },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
} : null;

const serviceSchema = service ? {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.description,
  serviceType: service.serviceType ?? service.name,
  provider: { "@id": `${siteUrlString}#organization` },
  areaServed: { "@type": "Place", name: "Worldwide" },
  url: canonicalUrl,
} : null;

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrlString}#organization`,
  name: siteName,
  legalName: "N3 Global Tech",
  alternateName: ["N3GlobalTech", "n3globaltech", "n3global.tech", "N3 Global Tech"],
  url: siteUrlString,
  logo: {
    "@type": "ImageObject",
    url: new URL("/n3logo.webp", siteUrl).href,
    width: 512,
    height: 512,
  },
  image: ogImage,
  description: "Custom software development company offering web, mobile, cloud, AI and SaaS product engineering for startups and enterprises.",
  email: "contact@n3global.tech",
  telephone: "+91-9188374340",
  priceRange: "$$",
  address: {
    "@type": "PostalAddress",
    streetAddress: "TK Junction, Near Capital Mall, Thana",
    addressLocality: "Kannur",
    addressRegion: "Kerala",
    postalCode: "670002",
    addressCountry: "IN",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 11.8745,
    longitude: 75.3704,
  },
  hasMap: "https://maps.google.com/?q=TK+Junction+Thana+Kannur+Kerala+670002",
  areaServed: [
    { "@type": "Place", name: "Kannur" },
    { "@type": "Place", name: "Kerala" },
    { "@type": "Place", name: "India" },
    { "@type": "Place", name: "Worldwide" },
  ],
  knowsAbout: [
    "Software Development",
    "Web Development",
    "Mobile App Development",
    "Cloud Solutions",
    "Artificial Intelligence",
    "SaaS Development",
    "UI/UX Design",
    "Digital Transformation",
    "MVP Development",
    "CRM",
    "ERP",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Services",
    itemListElement: [
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Web Development", description: "Custom websites & landing pages built with modern frameworks." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Mobile App Development", description: "iOS, Android and cross-platform mobile applications." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "UI/UX Design", description: "Wireframes, prototypes, and full design systems." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "MVP Development", description: "Validate ideas fast with launch-ready MVPs." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Product Redesign", description: "Modernize legacy products with refreshed UX and tech." } },
      { "@type": "Offer", itemOffered: { "@type": "Service", name: "Digital Marketing", description: "Grow online presence through SEO, content and ads." } },
    ],
  },
  sameAs: [
    "https://www.linkedin.com/company/n3-global-tech",
    "https://www.instagram.com/n3globaltech",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: "contact@n3global.tech",
    telephone: "+91-9188374340",
    availableLanguage: ["English"],
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrlString}#website`,
  name: siteName,
  alternateName: ["N3GlobalTech", "n3globaltech", "n3global.tech", "N3 Global Tech"],
  url: siteUrlString,
  publisher: { "@id": `${siteUrlString}#organization` },
  inLanguage: "en-US",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrlString}?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content={lockViewportScale
        ? "width=device-width, initial-scale=1, minimum-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
        : "width=device-width, initial-scale=1, viewport-fit=cover"}
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Show the splash on direct visits and refreshes. Internal links mark the
         next page so normal site navigation stays instant. -->
    <script is:inline>
      (function () {
        var skipSplash = false;
        try {
          var expectedPath = sessionStorage.getItem("n3-splash-skip-next");
          var currentPath = location.pathname.replace(/\/+$/, "") + location.search;
          skipSplash = expectedPath === currentPath;
          sessionStorage.removeItem("n3-splash-skip-next");
        } catch (_) {}

        document.documentElement.classList.add(
          skipSplash ? "site-splash-skipped" : "site-splash-pending",
        );

        document.addEventListener("click", function (event) {
          if (
            event.defaultPrevented ||
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) return;

          var anchor = event.target.closest && event.target.closest("a[href]");
          if (
            !anchor ||
            anchor.target === "_blank" ||
            anchor.hasAttribute("download")
          ) return;

          var destination;
          try {
            destination = new URL(anchor.href, location.href);
          } catch (_) {
            return;
          }

          if (
            destination.origin !== location.origin ||
            (destination.pathname === location.pathname &&
              destination.search === location.search &&
              destination.hash)
          ) return;

          try {
            var nextPath = destination.pathname.replace(/\/+$/, "") + destination.search;
            sessionStorage.setItem("n3-splash-skip-next", nextPath);
          } catch (_) {}
        });
      })();
    </script>

    <!-- Primary Meta -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta name="theme-color" content="#0ea5e9" />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow"} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/webp" href="/n3logo.webp" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Preload LCP candidate (used in navbar on every page) -->
    <link rel="preload" as="image" href="/n3logo.webp" type="image/webp" fetchpriority="high" />



    <!-- Sitemap -->
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!-- Structured Data: Organization (ProfessionalService) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)}></script>
    <!-- Structured Data: WebSite -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)}></script>
    <!-- Structured Data: Breadcrumbs -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)}></script>
    {faqSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>
    )}
    {articleSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)}></script>
    )}
    {serviceSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)}></script>
    )}
  </head>
  <body>
    <div
      id="site-splash"
      class="site-splash"
      role="status"
      aria-label="Loading N3 Global Tech"
      aria-live="polite"
    >
      <div class="site-splash__inner">
        <div class="site-splash__visual" aria-hidden="true">
          <img
            class="site-splash__poster"
            data-src="/media/loading-screen-poster.webp"
            width="360"
            height="640"
            alt=""
            decoding="sync"
            draggable="false"
          />
          <video
            class="site-splash__video"
            data-src="/media/loading-screen.mp4"
            muted
            playsinline
            webkit-playsinline
            loop
            preload="auto"
            disablepictureinpicture
            aria-hidden="true"></video>
        </div>
        <div
          class="site-splash__progress"
          role="progressbar"
          aria-label="Loading website"
        >
          <span></span>
        </div>
      </div>
    </div>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var splash = document.getElementById("site-splash");

        if (!splash || !root.classList.contains("site-splash-pending")) {
          if (splash) splash.remove();
          return;
        }

        root.classList.add("site-splash-locked");

        var visual = splash.querySelector(".site-splash__visual");
        var poster = splash.querySelector(".site-splash__poster");
        var video = splash.querySelector(".site-splash__video");
        var reduced = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        var shownAt = performance.now();
        var minimumVisibleTime = 2000;
        var finished = false;
        var main;

        // Assign the lightweight sources as soon as the splash markup is parsed.
        if (poster) {
          poster.addEventListener(
            "load",
            function () {
              if (visual) visual.classList.add("is-poster-ready");
            },
            { once: true },
          );
          poster.src = poster.dataset.src || "";
          if (poster.complete && poster.naturalWidth && visual) {
            visual.classList.add("is-poster-ready");
          }
        }
        if (video && !reduced) {
          video.defaultMuted = true;
          video.muted = true;
          video.playsInline = true;
          video.src = video.dataset.src || "";

          video.addEventListener(
            "playing",
            function () {
              var showVideo = function () {
                if (visual) visual.classList.add("is-playing");
              };
              if (typeof video.requestVideoFrameCallback === "function") {
                video.requestVideoFrameCallback(showVideo);
              } else {
                requestAnimationFrame(showVideo);
              }
            },
            { once: true },
          );

          var playRequest = video.play();
          if (playRequest && typeof playRequest.catch === "function") {
            // The first-frame poster and progress line remain a complete fallback
            // if a browser declines autoplay.
            playRequest.catch(function () {});
          }
        }

        function releasePage() {
          if (main) {
            main.inert = false;
            main.removeAttribute("aria-hidden");
          }
        }

        function finish() {
          if (finished) return;
          finished = true;
          splash.classList.add("is-leaving");
          releasePage();

          window.setTimeout(function () {
            root.classList.remove("site-splash-pending", "site-splash-locked");
            root.classList.add("site-splash-complete");
            splash.remove();
          }, reduced ? 0 : 360);
        }

        function finishAfterMinimumTime() {
          var remaining = minimumVisibleTime - (performance.now() - shownAt);
          if (remaining > 0) window.setTimeout(finish, remaining);
          else finish();
        }

        function pageIsReady() {
          // Let the browser commit the ready page before beginning the handoff.
          requestAnimationFrame(function () {
            requestAnimationFrame(finishAfterMinimumTime);
          });
        }

        document.addEventListener(
          "DOMContentLoaded",
          function () {
            main = document.getElementById("main-content");
            if (main && !finished) {
              main.inert = true;
              main.setAttribute("aria-hidden", "true");
            }
          },
          { once: true },
        );

        if (document.readyState === "complete") pageIsReady();
        else window.addEventListener("load", pageIsReady, { once: true });

        // Give the animation two seconds to register, but never let a slow
        // third-party asset keep the usable page covered beyond three seconds.
        window.setTimeout(finish, 3000);
        window.addEventListener(
          "pageshow",
          function (event) {
            if (event.persisted) finish();
          },
          { once: true },
        );
      })();
    </script>

    <a href="#main-content" class="skip-link">Skip to main content</a>
    <main id="main-content">
      <slot />
    </main>

    <!-- Custom Mouse Follower -->
    <div id="mouse-follower" class="mouse-follower" aria-hidden="true"></div>

    {/* Floating WhatsApp button hidden for now. Uncomment to re-enable. */}
    {false && (
      <a
        href="https://wa.me/919188374340?text=Hi%20N3%20Global%20Tech%2C%20I%27d%20like%20to%20discuss%20a%20project."
        class="wa-fab"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with N3 Global Tech on WhatsApp"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413"/>
        </svg>
        <span class="wa-fab__label">WhatsApp</span>
      </a>
    )}

    <script is:inline>
      (function () {
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal').forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.15 });
        document.querySelectorAll('.reveal').forEach(function (el) {
          io.observe(el);
        });

        // Mouse Follower — fine pointers only, and never when motion is reduced.
        const follower = document.getElementById('mouse-follower');
        const finePointer = window.matchMedia('(pointer: fine)').matches;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (follower && finePointer && !reducedMotion) {
          let mouseX = 0, mouseY = 0;
          let x = 0, y = 0;
          let rafId = null;
          let seen = false;

          document.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;

            // Sections can opt out of the ring (e.g. the hero, which has its own
            // pointer treatment) by setting data-cursor-hidden.
            if (e.target && e.target.closest) {
              follower.classList.toggle('is-hidden', !!e.target.closest('[data-cursor-hidden]'));
            }

            // Park it under the cursor on first sight so it doesn't fly in from 0,0.
            if (!seen) {
              seen = true;
              x = mouseX;
              y = mouseY;
              follower.classList.add('is-ready');
            }
            if (rafId === null) rafId = requestAnimationFrame(tick);
          }, { passive: true });

          // Idles instead of spinning a rAF loop forever.
          function tick() {
            rafId = null;
            const dx = mouseX - x;
            const dy = mouseY - y;

            if (Math.abs(dx) < 0.1 && Math.abs(dy) < 0.1) {
              x = mouseX;
              y = mouseY;
            } else {
              x += dx * 0.15;
              y += dy * 0.15;
              rafId = requestAnimationFrame(tick);
            }
            follower.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
          }

          // Delegated hover: two listeners total, and it covers elements added later
          // for free. (Binding per-element meant re-running it double-bound everything.)
          const INTERACTIVE = 'a, button, input, textarea, select, [role="button"], .service-tab-btn';

          document.addEventListener('mouseover', (e) => {
            if (e.target.closest(INTERACTIVE)) follower.classList.add('active');
          }, { passive: true });

          document.addEventListener('mouseout', (e) => {
            const left = e.target.closest(INTERACTIVE);
            // Ignore moves between children of the same control, else it flickers.
            if (left && !left.contains(e.relatedTarget)) follower.classList.remove('active');
          }, { passive: true });

          // Don't leave a stray ring floating when the cursor exits the window.
          document.addEventListener('mouseleave', () => follower.classList.remove('is-ready'), { passive: true });
          document.addEventListener('mouseenter', () => { if (seen) follower.classList.add('is-ready'); }, { passive: true });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --sky-50: #f0f9ff;
    --sky-100: #e0f2fe;
    --sky-200: #bae6fd;
    --sky-300: #7dd3fc;
    --sky-400: #38bdf8;
    --sky-500: #0ea5e9;
    --sky-600: #0284c7;
    --sky-700: #0369a1;
    --sky-800: #075985;
    --sky-900: #0c4a6e;

    --white: #ffffff;
    --gray-50: #f8fafc;
    --gray-100: #f1f5f9;
    --gray-200: #e2e8f0;
    --gray-300: #cbd5e1;
    --gray-400: #94a3b8;
    --gray-500: #64748b;
    --gray-600: #475569;
    --gray-700: #334155;
    --gray-800: #1e293b;
    --gray-900: #0f172a;

    --primary: var(--sky-500);
    --primary-dark: var(--sky-600);
    --primary-light: var(--sky-400);
    --primary-pale: var(--sky-50);

    --accent: #f59e0b;
    --accent-dark: #d97706;
    --accent-pale: #fffbeb;

    --font-body: var(--font-sans);
