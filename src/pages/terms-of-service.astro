<style>
  .legal-hero {
    padding: calc(80px + 3rem) 0 2.5rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border-bottom: 1px solid var(--gray-100);
  }
  .legal-hero__inner {
    text-align: center;
  }
  .legal-hero h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 1rem 0 0.5rem;
  }
  .legal-hero__meta {
    color: var(--gray-500);
    font-size: 0.9rem;
    margin: 0;
  }

  .legal-article {
    padding: 3rem 0 5rem;
  }
  .legal-narrow {
    max-width: 960px;
  }
  .legal-lead {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--gray-700);
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--gray-100);
  }
  .legal-lead--note {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--gray-600, #4b5563);
    margin-bottom: 2rem;
    padding: 0.75rem 1rem;
    background: var(--gray-50, #f8fafc);
    border-left: 3px solid var(--sky-400, #38bdf8);
    border-radius: 0 4px 4px 0;
  }
  .legal-narrow h2 {
    font-size: 1.4rem;
    font-weight: 500;
    margin: 2.5rem 0 0.75rem;
    color: var(--gray-900);
    letter-spacing: -0.01em;
  }
  .legal-narrow h3 {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 1.25rem 0 0.5rem;
    color: var(--gray-800, #1f2937);
  }
  .legal-narrow p,
  .legal-narrow ul {
    color: var(--gray-700);
    line-height: 1.8;
    font-size: 1rem;
    margin-bottom: 1.1rem;
  }
  .legal-narrow ul {
    padding-left: 1.5rem;
  }
  .legal-narrow li {
    margin-bottom: 0.5rem;
  }
  .legal-narrow a {
    color: var(--sky-700, #0369a1);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal-related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--gray-100);
    color: var(--gray-500);
    font-size: 0.95rem;
  }
</style>
