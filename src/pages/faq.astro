---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';

const faqs = [
  {
    question: "What types of businesses do you work with?",
    answer: "We work with startups, growing companies, established organisations, and enterprise teams looking to modernise operations, improve customer experiences, or accelerate digital growth. Whether you're launching a new product or transforming existing systems, we tailor our approach to your business objectives.",
  },
  {
    question: "Do you offer strategy or only implementation?",
    answer: "Both. Successful digital transformation requires more than technical execution. We work with clients from discovery and strategy through design, development, deployment, and ongoing optimisation — ensuring every solution aligns with business goals and delivers measurable results.",
  },
  {
    question: "How long does a typical project take?",
    answer: "Project timelines vary based on scope, complexity, and requirements: Business Websites take 4–8 weeks; Custom Platforms take 8–16 weeks; SaaS Products take 3–12 months; Digital Transformation Initiatives vary based on business objectives. Following our discovery process, we provide a clear proposal outlining milestones, deliverables, and timelines.",
  },
  {
    question: "Can you help if we are still defining our requirements?",
    answer: "Absolutely. Many clients approach us with an idea, challenge, or business objective rather than a complete specification. Our discovery process helps define requirements, identify opportunities, evaluate risks, and create a practical roadmap before development begins.",
  },
  {
    question: "Do you build custom software or only websites?",
    answer: "We do both. Our expertise includes Corporate Websites, Customer Portals, SaaS Platforms, Business Applications, AI-Powered Solutions, Workflow Automation, Cloud Infrastructure, and System Integrations. Every solution is tailored to the needs of the organisation rather than relying on one-size-fits-all products.",
  },
  {
    question: "What technologies do you work with?",
    answer: "Our core stack includes React, Next.js, Astro, Node.js, React Native, PostgreSQL, MongoDB, Firebase, and AWS, alongside modern AI/ML frameworks. We select the right stack per project based on your requirements — not a one-size-fits-all template.",
  },
  {
    question: "Can you integrate with our existing systems?",
    answer: "Yes. We regularly work with existing business systems, third-party platforms, CRMs, ERPs, accounting software, payment gateways, and cloud services. Our goal is to create connected digital ecosystems that improve efficiency rather than introducing unnecessary complexity.",
  },
  {
    question: "Do you provide AI and automation solutions?",
    answer: "Yes. We help organisations identify practical opportunities for AI adoption and automation. From intelligent workflows and customer-facing AI experiences to operational automation and data-driven insights, our solutions focus on measurable business impact rather than technology trends.",
  },
  {
    question: "Do you provide support after launch?",
    answer: "Absolutely. Launching a solution is only the beginning. We provide ongoing support, maintenance, security updates, performance monitoring, infrastructure management, and continuous improvements to ensure systems remain efficient, secure, and aligned with evolving business needs.",
  },
  {
    question: "Do you work with clients outside the UAE and India?",
    answer: "Yes. Our team supports businesses across the GCC and international markets. With operations spanning India and the UAE, we combine global expertise with regional understanding to deliver reliable solutions regardless of location.",
  },
  {
    question: "How do you ensure project success?",
    answer: "We believe successful projects are built on collaboration, transparency, and clear communication. Every engagement includes Discovery & Planning, Defined Project Roadmaps, Regular Progress Updates, Milestone-Based Delivery, Quality Assurance & Testing, and Post-Launch Support.",
  },
  {
    question: "How does pricing work, and how do I get a quote?",
    answer: "Every project is unique. Pricing depends on scope, complexity, timeline, integrations, and resource requirements. We offer both fixed-scope engagements and flexible delivery models. Use our Contact page to share your idea or requirements — you'll receive a transparent, tailored proposal outlining scope, timeline, and cost.",
  },
];
---

<Layout
  title="Frequently Asked Questions | N3 Global Tech"
  description="Answers to common questions about N3 Global Tech services, project timelines, technology, pricing, clients, and ongoing software support."
  keywords="N3 Global Tech FAQ, software development questions, project timeline, software development quote, technology stack, post-launch support"
  faqs={faqs}
>
  <Navbar />

  <main style="padding-top: 5rem;">
    <FaqSection />
  </main>

  <Footer />
</Layout>
