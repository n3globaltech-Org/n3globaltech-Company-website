---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FaqSection from "../components/FaqSection.astro";
import WhatWeDoCards from "../components/WhatWeDoCards.astro";
import ServicesHero from "../components/ServicesHero.astro";

const faqs = [
  {
    question:
      "Do you only provide services, or do you build your own products?",
    answer:
      "We are a hybrid company. While we build custom software and SaaS platforms for our clients, we also engineer and operate our own proprietary SaaS products like N3 ServiceBook and N3 FitBook. This dual approach ensures we stay sharp on production-level operations, security, and scalability.",
  },
  {
    question: "What is your primary technology stack?",
    answer:
      "We are framework-agnostic but heavily favor modern, battle-tested technologies. For the frontend, we use React, Next.js, and Astro. For backend APIs, we rely on Node.js and scalable databases like PostgreSQL and MongoDB. For mobile, we build native-feeling apps using React Native and Flutter.",
  },
  {
    question: "Do you work with startups or established enterprises?",
    answer:
      "Both. We help founders build scalable MVPs from scratch, and we assist established enterprises in modernizing legacy systems, migrating to the cloud, and implementing digital transformation strategies.",
  },
  {
    question: "How do you handle project pricing and scoping?",
    answer:
      "We offer multiple engagement models. For well-defined scopes, we provide fixed-price contracts with clear milestones. For ongoing development or scaling SaaS platforms, we offer dedicated team retainers. We usually start with a paid discovery phase to map out the exact requirements and select the best model.",
  },
];
---

<Layout
  title="Software Development Services | Web, Mobile, Cloud & AI"
  description="End-to-end software development services from a Kerala-based team serving clients globally. Custom software, SaaS, web apps, mobile apps, cloud, AI/ML and digital transformation."
  keywords="software development services, custom software development, SaaS development, web development services, mobile app development services, cloud services, AI development services, software development Kerala, software company India"
  faqs={faqs}
>
  <Navbar />

  <!-- Google Company-Info Inspired Hero Section -->
  <ServicesHero />

  <!-- Interactive What We Do Overview (Stacked Cards Deck) -->
  <WhatWeDoCards showTitle={false} linkToContact={true} />

  <!-- Tech Stack -->
  <section class="section-sm tech-stack-section">
    <div class="container">
      <div class="section-header">
        <div class="badge badge-sky">Our Stack</div>
        <h2>The <span class="text-gradient">Tools</span> We Build With</h2>
        <p>
          We pick the right tool for the problem, not the other way around.
          Here's the stack we use most often across web, mobile, cloud, and SaaS
          projects.
        </p>
      </div>

      <div class="tech-grid">
        {
          [
            ["React", "Frontend"],
            ["Next.js", "Full-stack web"],
            ["Astro", "Marketing & docs"],
            ["Node.js", "Backend / APIs"],
            ["React Native", "Mobile cross-platform"],
            ["Flutter", "Mobile native UI"],
            ["PostgreSQL", "Relational database"],
            ["MongoDB", "Document database"],
            ["Firebase", "Realtime / auth"],
            ["AWS", "Cloud infrastructure"],
            ["Docker", "Containers"],
            ["Kubernetes", "Orchestration"],
          ].map(([name, role]) => (
            <div class="tech-tile">
              <span class="tech-tile__name">{name}</span>
              <span class="tech-tile__role">{role}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>


  <!-- Unified FAQ Section -->
  <FaqSection limit={6} />

  <!-- CTA -->
  <section class="section-sm">
    <div class="container">
      <div class="services-cta-box">
        <div class="services-cta-box__content">
          <h2>Ready to Transform Your Business?</h2>
          <p>
            Let's discuss exactly what you need and build a plan that works for
            your goals and budget.
          </p>
        </div>
        <div class="services-cta-box__actions">
          <a href="/contact" class="btn btn-primary btn-lg"
            >Start a Conversation</a
          >
          <a href="/work" class="btn btn-ghost btn-lg">See Our Work</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* Badge colors */
  .badge-sky {
    background: var(--sky-50);
    color: var(--sky-700);
    border: 1px solid var(--sky-100);
  }
  .badge-violet {
    background: #f5f3ff;
    color: #7c3aed;
    border: 1px solid #ddd6fe;
  }
  .badge-teal {
    background: #f0fdfa;
    color: #0d9488;
    border: 1px solid #ccfbf1;
  }
  .badge-amber {
    background: #fffbeb;
    color: #d97706;
    border: 1px solid #fde68a;
  }
  .badge-rose {
    background: #fff1f2;
    color: #e11d48;
    border: 1px solid #fecdd3;
  }
  .badge-indigo {
    background: #eef2ff;
    color: #4f46e5;
    border: 1px solid #c7d2fe;
  }

  /* Tech stack */
  .tech-stack-section {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    max-width: 980px;
    margin: 0 auto;
  }
  .tech-tile {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1.1rem 1.25rem;
    background: #ffffff;
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-md);
    transition: var(--transition);
  }
  .tech-tile:hover {
    transform: translateY(-2px);
    border-color: var(--sky-200);
    box-shadow: 0 6px 16px rgba(14, 165, 233, 0.08);
  }
  .tech-tile__name {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    color: var(--gray-900);
    letter-spacing: -0.01em;
  }
  .tech-tile__role {
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    color: var(--text-muted);
    font-weight: 400;
  }
  @media (max-width: 800px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .tech-grid {
      grid-template-columns: 1fr;
    }
  }

  /* CTA box */
  .services-cta-box {
    background: linear-gradient(135deg, var(--sky-50) 0%, var(--white) 100%);
    border: 1.5px solid var(--sky-100);
    border-radius: var(--radius-xl);
    padding: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .services-cta-box__content h2 {
    font-family: var(--font-sans);
    font-size: var(--heading-sm);
    font-weight: 500;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .services-cta-box__content p {
    font-family: var(--font-sans);
    color: var(--text-secondary);
    font-size: var(--body-md);
    line-height: 1.6;
  }

  .services-cta-box__actions {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .services-cta-box {
      flex-direction: column;
      text-align: center;
    }
    .services-cta-box__actions {
      justify-content: center;
    }
  }

  /* ===== STACKED CARDS SCROLL SECTION HEADER & LAYOUT ===== */
  .stacked-section-header {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    margin: 0 auto 3.2rem auto !important;
    width: 100% !important;
  }

  .stacked-section-title {
    font-family: var(--font-sans) !important;
    font-size: var(--heading-md) !important;
    font-weight: 500 !important;
    color: #0f172a !important;
    line-height: 1.1 !important;
    letter-spacing: -0.02em !important;
    margin: 0 auto !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
  }
</style>
