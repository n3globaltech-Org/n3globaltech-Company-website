<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var successMsg = document.getElementById('form-success');
    var errorMsg = document.getElementById('form-error');
    var errorText = document.getElementById('form-error-text');
    var submitBtn = document.getElementById('submit-btn');
    var submitLabel = submitBtn ? submitBtn.querySelector('.btn-submit__label') : null;

    if (!form || !successMsg || !errorMsg || !submitBtn || !submitLabel) return;

    // Prefill form from URL query parameters (e.g., from project cards)
    try {
      var params = new URLSearchParams(window.location.search);
      var projectParam = params.get('project');
      var msgParam = params.get('msg') || params.get('message');
      
      if (projectParam || msgParam) {
        var messageInput = document.getElementById('message');
        if (messageInput) {
          var prefillText = "";
          if (projectParam) {
            prefillText += "Regarding the \"" + projectParam + "\" project:\n";
          }
          if (msgParam) {
            prefillText += msgParam;
          }
          messageInput.value = prefillText;
        }
      }
    } catch (e) {
      console.error('Error prefilling form:', e);
    }

    // Initialize Custom Dropdown
    (function() {
      var selectWrap = document.getElementById('custom-select-service');
      if (!selectWrap) return;

      var trigger = selectWrap.querySelector('.custom-select__trigger');
      var label = selectWrap.querySelector('.custom-select__label');
      var menu = selectWrap.querySelector('.custom-select__menu');
      var options = selectWrap.querySelectorAll('.custom-select__option');
      var hiddenSelect = document.getElementById('service');

      if (!trigger || !label || !menu || !hiddenSelect) return;

      function toggleMenu(open) {
        var isOpen = open !== undefined ? open : !selectWrap.classList.contains('is-open');
        selectWrap.classList.toggle('is-open', isOpen);
        trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      }

      trigger.addEventListener('click', function(e) {
        e.stopPropagation();
        toggleMenu();
      });

      options.forEach(function(opt) {
        opt.addEventListener('click', function(e) {
          e.stopPropagation();
          var val = opt.getAttribute('data-value');
          var text = opt.querySelector('span') ? opt.querySelector('span').textContent : '';

          hiddenSelect.value = val;
          hiddenSelect.dispatchEvent(new Event('change', { bubbles: true }));

          label.textContent = text;
          label.classList.remove('is-placeholder');

          options.forEach(function(o) { o.classList.remove('is-selected'); });
          opt.classList.add('is-selected');

          toggleMenu(false);
          clearError();
        });
      });

      document.addEventListener('click', function(e) {
        if (!selectWrap.contains(e.target)) {
          toggleMenu(false);
        }
      });

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && selectWrap.classList.contains('is-open')) {
          toggleMenu(false);
          trigger.focus();
        }
      });
    })();

    function showError(text) {
      errorText.textContent = text || 'Something went wrong. Please try again or email us at contact@n3global.tech.';
      errorMsg.hidden = false;
      errorMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function clearError() {
      errorMsg.hidden = true;
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearError();

      // Honeypot: bots fill this, humans never see it
      var hp = form.querySelector('#website');
      if (hp && hp.value) return;

      var data = new FormData(form);
      var name = (data.get('name') || '').toString().trim();
      var email = (data.get('email') || '').toString().trim();
      var phone = (data.get('phone') || '').toString().trim();
      var company = (data.get('company') || '').toString().trim();
      var message = (data.get('message') || '').toString().trim();
      var service = (data.get('service') || '').toString();

      if (!name) {
        showError('Please enter your name.');
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('Please enter a valid email address.');
        return;
      }
      if (phone && (phone.length < 7 || phone.length > 30)) {
        showError('Please enter a valid phone number.');
        return;
      }
      if (!service) {
        showError('Please select an area of interest.');
        var trigger = document.getElementById('service-trigger');
        if (trigger) trigger.focus();
        return;
      }
      if (!message || message.length < 10) {
        showError('Please tell us a bit more about your project (at least 10 characters).');
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = 'Sending...';

      try {
        var res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: name,
            email: email,
            phone: phone || null,
            company: company || null,
            service: service,
            interest: service,
            project_type: service,
            pageUrl: window.location.href,
            message: message,
            metadata: {
              referrer: document.referrer || null,
            },
          }),
        });

        var body;
        try { body = await res.json(); } catch (_) { body = {}; }

        if (!res.ok || body.success === false) {
          var msg = body && body.message ? body.message : 'Submission failed. Please try again.';
          showError(msg);
          submitBtn.disabled = false;
          submitLabel.textContent = 'Send Message';
          return;
        }

        form.style.display = 'none';
        successMsg.classList.add('visible');
      } catch (err) {
        console.error('Contact form submit error:', err);
        showError('We could not reach our servers. Please try again or email contact@n3global.tech.');
        submitBtn.disabled = false;
        submitLabel.textContent = 'Send Message';
      }
    });
  })();
</script>
