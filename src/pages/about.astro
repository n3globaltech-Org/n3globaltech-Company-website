---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrinciplesSection from '../components/PrinciplesSection.astro';
import TeamSection from '../components/TeamSection.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="About Us | Our Story, Founders & Mission"
  description="Meet the team behind N3 Global Tech. Founded by Nibras, Nabeel, Nafi, and Farseen, four engineers turned co-founders building custom software and SaaS for businesses in Kerala, India, and beyond."
  keywords="about N3 Global Tech, n3globaltech, N3GlobalTech, software company Kerala, software company Kannur, custom software founders, N3 team, Nibras Nabeel Nafi Farseen, Kerala tech founders, software company story"
>
  <Navbar />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://www.n3global.tech/about/"
    },
    "name": "About N3 Global Tech",
    "description": "Meet the team behind N3 Global Tech. Four engineers turned founders building custom software and SaaS for businesses worldwide.",
    "publisher": {
      "@id": "https://www.n3global.tech/#organization"
    }
  })}></script>

  <!-- About N3 Global Tech Hero Section -->
  <section class="about-hero-custom">
    <div class="container about-hero__container">
      <div class="about-hero__content">
        <div class="about-hero__label">
          <span class="about-hero__label-square"></span>
          ABOUT N3 GLOBAL TECH
        </div>

        <h1 class="about-hero__title">
          Engineers turned founders,<br class="hide-sm" />
          building software that helps<br class="hide-sm" />
          businesses move forward.
        </h1>

        <div class="about-hero__strip">
          <!-- Desktop static strip -->
          <div class="about-hero__strip-desktop">
            <span class="about-hero__strip-item">Software Engineering</span>
            <span class="about-hero__strip-item">SaaS &amp; Products</span>
            <span class="about-hero__strip-item">AI &amp; Automation</span>
          </div>

          <!-- Mobile horizontally scrolling marquee strip -->
          <div class="about-hero__strip-marquee">
            <div class="about-hero__marquee-track">
              <div class="about-hero__marquee-group">
                <span class="about-hero__strip-item">Software Engineering</span>
                <span class="about-hero__strip-item">SaaS &amp; Products</span>
                <span class="about-hero__strip-item">AI &amp; Automation</span>
              </div>
              <div class="about-hero__marquee-group" aria-hidden="true">
                <span class="about-hero__strip-item">Software Engineering</span>
                <span class="about-hero__strip-item">SaaS &amp; Products</span>
                <span class="about-hero__strip-item">AI &amp; Automation</span>
              </div>
              <div class="about-hero__marquee-group" aria-hidden="true">
                <span class="about-hero__strip-item">Software Engineering</span>
                <span class="about-hero__strip-item">SaaS &amp; Products</span>
                <span class="about-hero__strip-item">AI &amp; Automation</span>
              </div>
              <div class="about-hero__marquee-group" aria-hidden="true">
                <span class="about-hero__strip-item">Software Engineering</span>
                <span class="about-hero__strip-item">SaaS &amp; Products</span>
                <span class="about-hero__strip-item">AI &amp; Automation</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="about-hero__media">
        <img
          src="/n3-about-section-team-image.png"
          alt="N3 Global Tech engineering team collaborating on software solutions"
          class="about-hero__image"
          width="597"
          height="500"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Built by Engineers: two images + stats -->
  <section class="built-section">
    <div class="container built-section__container">

      <!-- Top: label + heading -->
      <div class="built-section__top">
        <div class="built-section__label">
          <span class="built-section__label-sq"></span>
          BUILT BY ENGINEERS
        </div>
        <h2 class="built-section__heading">
          We bring engineering expertise, product thinking, and hands-on experience to build software that businesses can rely on.
        </h2>
      </div>

      <!-- Bottom: images + stats -->
      <div class="built-section__bottom">
        <!-- Two images side by side -->
        <div class="built-section__images">
          <div class="built-section__img-wrap">
            <img
              src="/first.webp"
              alt="N3 Global Tech team collaborating"
              class="built-section__img"
              loading="lazy"
            />
          </div>
          <div class="built-section__img-wrap">
            <img
              src="/second.webp"
              alt="N3 Global Tech engineering work"
              class="built-section__img"
              loading="lazy"
            />
          </div>
        </div>

        <!-- 2x2 stats grid -->
        <div class="built-section__stats">
          <div class="built-stat">
            <span class="built-stat__num">06</span>
            <span class="built-stat__label">Technology Specialists</span>
          </div>
          <div class="built-stat">
            <span class="built-stat__num">30+</span>
            <span class="built-stat__label">Active Business Partners</span>
          </div>
          <div class="built-stat">
            <span class="built-stat__num">03+</span>
            <span class="built-stat__label">Years Shipping SaaS</span>
          </div>
          <div class="built-stat">
            <span class="built-stat__num">02</span>
            <span class="built-stat__label">Global Hubs (India &amp; UAE)</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Origin Story: Modern Editorial Grid -->
  <section class="section story-section">
    <div class="container story-section__container">
      <div class="story-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> OUR JOURNEY
        </div>
        <h2 class="story-section__title">Behind N3 Global Tech</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="story-grid">
        <!-- Story Card 1 -->
        <article class="story-card story-card--full">
          <div class="story-card__flex-row">
            <div class="story-card__col">
              <div class="story-card__badge">01 / THE BEGINNING</div>
              <h3 class="story-card__title">Thalassery Roots</h3>
              <p class="story-card__text">
                Our story starts at <strong>Thalassery Engineering College</strong>, where Nibras, Nabeel, Nafi, and Farseen studied together. What began as a shared passion for solving complex engineering challenges grew, project by project, into an enterprise technology agency.
              </p>
            </div>
            <div class="story-card__col">
              <p class="story-card__text">
                Across our third-year mini projects and final-year build, we got hands-on with shipping production software that real users actually rely on. Farseen played a defining role here, both as a peer and mentor, shaping our standard of engineering rigor.
              </p>
            </div>
          </div>
        </article>

        <!-- Story Card 2 -->
        <article class="story-card story-card--full story-card--highlight">
          <div class="story-card__flex-row">
            <div class="story-card__col">
              <div class="story-card__badge story-card__badge--sky">02 / GLOBAL IMPACT</div>
              <h3 class="story-card__title">Today &amp; The GCC Expansion</h3>
              <p class="story-card__text">
                Today, N3 Global Tech has shipped multiple SaaS platforms — <strong>N3 FitBook, N3 ServiceBook, and N3 BusinessBook</strong> — empowering <strong>over 30 companies</strong> to transition from manual workflows to robust digital infrastructure.
              </p>
            </div>
            <div class="story-card__col">
              <div class="dubai-badge">
                <span class="dubai-badge__dot"></span>
                Our Global Presence
              </div>
              <p class="story-card__text">
                N3 Global Tech serves businesses across India, the UAE, and international markets through engineering expertise, cloud-first solutions, and product innovation.
              </p>
              <p class="story-card__text">
                Across the GCC, we operate through <strong>Klay Agency</strong> — our GCC-facing brand. Together we work as one multidisciplinary team across India and the UAE, combining strategy, technology, and execution to deliver high-grade software solutions across the wider region.
              </p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>



  <!-- Creative Team Spotlight -->
  <TeamSection />

  <!-- Mission & Vision -->
  <section class="section mv-section">
    <div class="container mv-section__container">
      <div class="mv-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> OUR PURPOSE
        </div>
        <h2 class="mv-section__title">Mission &amp; Vision</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="mv-grid">
        <article class="mv-card">
          <span class="mv-card__num">01</span>
          <h3 class="mv-card__heading">Our Mission</h3>
          <p class="mv-card__desc">We help businesses replace manual, error-prone workflows with software that actually holds up — scalable systems that remove friction instead of adding it, built by engineers who've run their own products in production.</p>
        </article>

        <article class="mv-card">
          <span class="mv-card__num">02</span>
          <h3 class="mv-card__heading">Our Vision</h3>
          <p class="mv-card__desc">To be the engineering partner GCC and Indian businesses call first when a technology problem is too complex to hand to a template — proven not by claims, but by the platforms we've shipped and kept running.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Three Principles -->
  <PrinciplesSection />

  <!-- FAQ Section (Top 6 FAQs) -->
  <FaqSection limit={6} />

  <!-- High-End Glassmorphic CTA -->
  <section class="section about-cta-section">
    <div class="container">
      <div class="about-cta">
        <div class="about-cta__glow"></div>
        <h2 class="about-cta__title">Want to build something great together?</h2>
        <p class="about-cta__desc">Whether you have a specific software project in mind or want to explore scalable technology solutions for your business, we're ready. We respond within 24 hours.</p>
        
        <div class="about-cta__actions">
          <a href="/contact/" class="hero__pill-link">
            <span class="hero__pill-text">Start a Project</span>
            <span class="hero__pill-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
          <a href="/work/" class="about-cta__secondary-btn">See Our Work</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      function initAboutHeroScroll() {
        var statement = document.getElementById("about-hero-title");
        if (!statement) return;

        var text = statement.textContent.trim();
        var words = text.split(/\s+/);
        statement.innerHTML = words.map(function(w) {
          return '<span class="about-word">' + w + ' </span>';
        }).join('');

        var wordSpans = statement.querySelectorAll(".about-word");
        var heroSection = statement.closest(".about-hero");

        function updateProgress() {
          if (!heroSection || !wordSpans.length) return;
          var rect = heroSection.getBoundingClientRect();
          var windowH = window.innerHeight;
          
          var start = windowH * 0.85;
          var end = windowH * 0.35;
          var progress = (start - rect.top) / (start - end);
          progress = Math.max(0, Math.min(1, progress));

          var activeIndex = Math.floor(progress * wordSpans.length);
          wordSpans.forEach(function(span, idx) {
            if (idx <= activeIndex) {
              span.classList.add("is-active");
            } else {
              span.classList.remove("is-active");
            }
          });
        }

        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAboutHeroScroll);
      } else {
        initAboutHeroScroll();
      }
    })();
  </script>

  <Footer />
</Layout>

<style>
  /* ─── BUILT BY ENGINEERS SECTION ─────────────────── */
  .built-section {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 5rem 0 5.5rem;
  }

  .built-section__top {
    margin-bottom: 3rem;
  }

  .built-section__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #475569;
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .built-section__label-sq {
    width: 7px;
    height: 7px;
    background-color: #0284c7;
    display: inline-block;
    border-radius: 1.5px;
    flex-shrink: 0;
  }

  .built-section__heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    color: #0f172a;
    font-family: var(--font-sans);
    line-height: 1.3;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: none;
  }

  /* Bottom row: images left, stats right */
  .built-section__bottom {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4rem;
    align-items: center;
  }

  /* Two portrait images side by side */
  .built-section__images {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .built-section__img-wrap {
    width: 230px;
    height: 260px;
    border-radius: 14px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .built-section__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 14px;
  }

  /* 2×2 stats grid */
  .built-section__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .built-stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.75rem 1.5rem;
  }

  /* Horizontal divider — top row */
  .built-stat:nth-child(1),
  .built-stat:nth-child(2) {
    border-bottom: 1px solid #e2e8f0;
    padding-top: 0;
  }

  /* Vertical divider — left column */
  .built-stat:nth-child(1),
  .built-stat:nth-child(3) {
    border-right: 1px solid #e2e8f0;
    padding-left: 0;
  }

  /* Right column — no left padding needed */
  .built-stat:nth-child(2),
  .built-stat:nth-child(4) {
    padding-right: 0;
  }

  /* Bottom row — no bottom padding */
  .built-stat:nth-child(3),
  .built-stat:nth-child(4) {
    padding-bottom: 0;
  }

  .built-stat__num {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: #0f172a;
    font-family: var(--font-sans);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .built-stat__label {
    font-size: 0.88rem;
    color: #64748b;
    font-weight: 400;
    letter-spacing: -0.005em;
  }

  /* ABOUT N3 GLOBAL TECH HERO */
  .about-hero-custom {
    padding-top: calc(72px + 4.25rem);
    padding-bottom: 5.5rem;
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
    box-sizing: border-box;
  }

  .about-hero__container {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
    box-sizing: border-box;
  }

  .about-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .about-hero__label {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #475569;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .about-hero__label-square {
    width: 7px;
    height: 7px;
    background-color: #0284c7;
    display: inline-block;
    border-radius: 1.5px;
    flex-shrink: 0;
  }

  .about-hero__title {
    font-size: clamp(2.1rem, 3.2vw, 2.85rem);
    font-weight: 500;
    color: #0f172a;
    font-family: var(--font-sans);
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin: 0 0 2.75rem 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  /* Strip spans full left-column width */
  .about-hero__strip {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 8px;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    min-width: 0;
  }

  .about-hero__strip-desktop {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    padding: 1rem 1.75rem;
    width: 100%;
    box-sizing: border-box;
  }

  .about-hero__strip-desktop .about-hero__strip-item:nth-child(1) {
    text-align: left;
  }

  .about-hero__strip-desktop .about-hero__strip-item:nth-child(2) {
    text-align: center;
  }

  .about-hero__strip-desktop .about-hero__strip-item:nth-child(3) {
    text-align: right;
  }

  .about-hero__strip-marquee {
    display: none;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  .about-hero__strip-item {
    font-size: 0.9rem;
    font-weight: 500;
    color: #475569;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Photo: portrait frame matching reference proportions */
  .about-hero__media {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 28px -8px rgba(15, 23, 42, 0.12);
    width: 355px;
    height: 405px;
    flex-shrink: 0;
    box-sizing: border-box;
    align-self: center;
  }

  .about-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    border-radius: 18px;
  }

  /* STORY SECTION */
  .story-section {
    padding: 4.5rem 0;
    background: #ffffff;
  }

  .story-section__header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .story-section__title {
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    font-weight: 500;
    color: #0f172a;
    font-family: var(--font-sans);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
  }

  .story-section__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
  }

  .story-section__kicker-sq {
    width: 6.5px;
    height: 6.5px;
    background-color: #0284c7;
    display: inline-block;
    border-radius: 1px;
  }

  .story-section__divider {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
    margin-bottom: 2rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .story-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .story-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.04);
    border-color: #e2e8f0;
  }

  .story-card--full {
    grid-column: 1 / -1;
  }

  .story-card--highlight {
    background: linear-gradient(135deg, #f8fafc 0%, #f0f9ff 100%);
    border-color: #e0f2fe;
  }

  .story-card__badge {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #64748b;
    text-transform: uppercase;
  }

  .story-card__badge--sky {
    color: #0284c7;
  }

  .story-card__title {
    font-size: 1.5rem;
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .story-card__text {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

