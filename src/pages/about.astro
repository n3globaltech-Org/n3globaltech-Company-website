    flex-direction: column;
    gap: 0.75rem;
  }

  .dubai-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: #0369a1;
    background: #e0f2fe;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
