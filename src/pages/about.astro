    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }




  /* MISSION & VISION */
  .mv-section {
    padding: 3.75rem 0;
    background: #ffffff;
  }

  .mv-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .mv-section__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .mv-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 20px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .mv-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.04);
    border-color: #e2e8f0;
  }

  .mv-card__num {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #0284c7;
  }

  .mv-card__heading {
    font-size: 1.5rem;
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .mv-card__desc {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  /* ABOUT CTA */
  .about-cta-section {
