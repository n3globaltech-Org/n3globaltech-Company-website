---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PrinciplesSection from '../components/PrinciplesSection.astro';
import ClientLogosMarquee from '../components/ClientLogosMarquee.astro';
import TeamSection from '../components/TeamSection.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="About Us | Our Story, Founders & Mission"
  description="Meet the team behind N3 Global Tech. Founded by Nibras, Nabeel, Nafi, and Farseen, four engineers turned co-founders building custom software and SaaS for businesses in Kerala, India, and beyond."
  keywords="about N3 Global Tech, n3globaltech, N3GlobalTech, software company Kerala, software company Kannur, custom software founders, N3 team, Nibras Nabeel Nafi Farseen, Kerala tech founders, software company story"
>
  <Navbar />

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "https://www.n3global.tech/about/"
    },
    "name": "About N3 Global Tech",
    "description": "Meet the team behind N3 Global Tech. Four engineers turned founders building custom software and SaaS for businesses worldwide.",
    "publisher": {
      "@id": "https://www.n3global.tech/#organization"
    }
  })}></script>

  <!-- Dedicated Unique About Hero -->
  <section class="about-hero-custom">
    <div class="container about-hero-custom__container">
      <div class="story-section__kicker">
        <span class="story-section__kicker-sq"></span> ABOUT N3 GLOBAL TECH
      </div>
      <h1 class="about-hero-custom__title">
        Engineers turned founders, building custom software &amp; SaaS for businesses worldwide.
      </h1>
      <p class="about-hero-custom__subtitle">
        Founded in Kerala with engineering hubs across India &amp; the UAE, we specialize in software engineering, cloud infrastructure, SaaS development, and AI-powered automation — building products that scale.
      </p>

      <div class="about-stats-grid">
        <div class="about-stat-card">
          <div class="about-stat-card__num">06</div>
          <div class="about-stat-card__label">Technology Specialists</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-card__num">30+</div>
          <div class="about-stat-card__label">Active Business Partners</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-card__num">03+</div>
          <div class="about-stat-card__label">Years Shipping SaaS</div>
        </div>
        <div class="about-stat-card">
          <div class="about-stat-card__num">02</div>
          <div class="about-stat-card__label">Global Hubs (India &amp; UAE)</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Client Logos Marquee -->
  <ClientLogosMarquee />

  <!-- Origin Story: Modern Editorial Grid -->
  <section class="section story-section">
    <div class="container story-section__container">
      <div class="story-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> OUR JOURNEY
        </div>
        <h2 class="story-section__title">Behind N3 Global Tech</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="story-grid">
        <!-- Story Card 1 -->
        <article class="story-card">
          <div class="story-card__badge">01 / THE BEGINNING</div>
          <h3 class="story-card__title">Thalassery Roots</h3>
          <p class="story-card__text">
            Our story starts at <strong>Thalassery Engineering College</strong>, where Nibras, Nabeel, Nafi, and Farseen studied together. What began as a shared passion for solving complex engineering challenges grew, project by project, into an enterprise technology agency.
          </p>
          <p class="story-card__text">
            Across our third-year mini projects and final-year build, we got hands-on with shipping production software that real users actually rely on. Farseen played a defining role here, both as a peer and mentor, shaping our standard of engineering rigor.
          </p>
        </article>

        <!-- Story Card 2 -->
        <article class="story-card">
          <div class="story-card__badge">02 / FIRST MILESTONE</div>
          <h3 class="story-card__title">UAE E-Commerce & FitBook</h3>
          <p class="story-card__text">
            Our first client milestone arrived during our final year: a custom <strong>perfume e-commerce platform for a client in the UAE</strong>. It was the moment we transformed from students to a dedicated engineering team.
          </p>
          <p class="story-card__text">
            Soon after came our flagship fitness product — <strong>N3 FitBook</strong> — managing memberships, automated recurring payments, and daily operations for gym owners. That platform remains active today, serving growing operations across 2+ years of continuous updates.
          </p>
        </article>

        <!-- Story Card 3: Experience Pills -->
        <article class="story-card story-card--full">
          <div class="story-card__badge">03 / SPECIALIZATION</div>
          <h3 class="story-card__title">Industry Mastery Before Uniting</h3>
          <p class="story-card__text story-card__text--lead">
            After graduation, each of us gained real-world domain expertise in top engineering hubs before founding N3 Global Tech:
          </p>

          <div class="experience-grid">
            <div class="experience-pill">
              <div class="experience-pill__header">
                <span class="experience-pill__name">Nabeel</span>
                <span class="experience-pill__tag">Kochi</span>
              </div>
              <p class="experience-pill__role">Mobile Developer</p>
              <p class="experience-pill__desc">Engineered native iOS, Android, and cross-platform mobile apps for production users.</p>
            </div>

            <div class="experience-pill">
              <div class="experience-pill__header">
                <span class="experience-pill__name">Nafi</span>
                <span class="experience-pill__tag">Wayanad</span>
              </div>
              <p class="experience-pill__role">Java &amp; Backend Engineer</p>
              <p class="experience-pill__desc">Anchored enterprise backend architecture, high-throughput APIs, and microservices.</p>
            </div>

            <div class="experience-pill">
              <div class="experience-pill__header">
                <span class="experience-pill__name">Nibras</span>
                <span class="experience-pill__tag">Abu Dhabi</span>
              </div>
              <p class="experience-pill__role">Cloud &amp; DevOps Engineer</p>
              <p class="experience-pill__desc">Designed resilient cloud infrastructure, automated CI/CD pipelines, and scalability systems.</p>
            </div>
          </div>
        </article>

        <!-- Story Card 4 -->
        <article class="story-card story-card--full story-card--highlight">
          <div class="story-card__flex-row">
            <div class="story-card__col">
              <div class="story-card__badge story-card__badge--sky">04 / GLOBAL IMPACT</div>
              <h3 class="story-card__title">Today &amp; The GCC Expansion</h3>
              <p class="story-card__text">
                Today, N3 Global Tech has shipped multiple SaaS platforms — <strong>N3 FitBook, N3 ServiceBook, and N3 BusinessBook</strong> — empowering <strong>over 30 companies</strong> to transition from manual workflows to robust digital infrastructure.
              </p>
            </div>
            <div class="story-card__col">
              <div class="dubai-badge">
                <span class="dubai-badge__dot"></span>
                Our Global Presence
              </div>
              <p class="story-card__text">
                N3 Global Tech serves businesses across India, the UAE, and international markets through engineering expertise, cloud-first solutions, and product innovation.
              </p>
              <p class="story-card__text">
                Across the GCC, we operate through <strong>Klay Agency</strong> — our GCC-facing brand. Together we work as one multidisciplinary team across India and the UAE, combining strategy, technology, and execution to deliver high-grade software solutions across the wider region.
              </p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="section wwd-section">
    <div class="container wwd-section__container">
      <div class="wwd-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> CAPABILITIES
        </div>
        <h2 class="wwd-section__title">What We Do</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="wwd-grid">
        <article class="wwd-item">
          <span class="wwd-item__num">01</span>
          <h3 class="wwd-item__title">Custom Software Development</h3>
          <p class="wwd-item__desc">Software tailored to your business requirements — built to improve productivity, streamline operations, and accelerate growth.</p>
        </article>
        <article class="wwd-item">
          <span class="wwd-item__num">02</span>
          <h3 class="wwd-item__title">SaaS Product Development</h3>
          <p class="wwd-item__desc">From concept and architecture to deployment and scaling, we build SaaS platforms designed for long-term success.</p>
        </article>
        <article class="wwd-item">
          <span class="wwd-item__num">03</span>
          <h3 class="wwd-item__title">Cloud Infrastructure &amp; DevOps</h3>
          <p class="wwd-item__desc">Secure, resilient, high-performance cloud environments built for modern digital businesses.</p>
        </article>
        <article class="wwd-item">
          <span class="wwd-item__num">04</span>
          <h3 class="wwd-item__title">AI &amp; Intelligent Automation</h3>
          <p class="wwd-item__desc">Practical AI solutions that automate workflows, improve decision-making, and increase efficiency.</p>
        </article>
        <article class="wwd-item">
          <span class="wwd-item__num">05</span>
          <h3 class="wwd-item__title">Web &amp; Mobile Applications</h3>
          <p class="wwd-item__desc">Modern digital products that balance performance, usability, and business impact.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Products We've Built -->
  <section class="section products-built-section">
    <div class="container products-built-section__container">
      <div class="products-built-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> OUR PRODUCTS
        </div>
        <h2 class="products-built-section__title">Products We've Built</h2>
      </div>
      <div class="story-section__divider"></div>

      <p class="products-built-section__intro">
        Beyond client projects, we invest in developing software products that solve real operational challenges.
      </p>

      <div class="products-built-grid">
        <article class="products-built-item">
          <h3 class="products-built-item__title">Circle for Work</h3>
          <p class="products-built-item__desc">A hyperlocal community trust platform connecting local service providers, rentals, and skilled workers with neighbors for everyday jobs, products, and equipment sharing.</p>
        </article>
        <article class="products-built-item">
          <h3 class="products-built-item__title">N3 FitBook</h3>
          <p class="products-built-item__desc">A fitness business management platform helping gym operators manage memberships, recurring payments, attendance, and daily operations.</p>
        </article>
        <article class="products-built-item">
          <h3 class="products-built-item__title">N3 ServiceBook</h3>
          <p class="products-built-item__desc">A service management platform designed to streamline customer interactions and service delivery workflows.</p>
        </article>
        <article class="products-built-item">
          <h3 class="products-built-item__title">N3 BusinessBook</h3>
          <p class="products-built-item__desc">A business operations platform that helps organizations centralize processes, improve visibility, and scale more effectively.</p>
        </article>
      </div>

      <p class="products-built-section__outro">
        Building and managing our own products gives us firsthand experience in product development, infrastructure scaling, user adoption, and long-term software evolution.
        <a href="/products/" class="products-built-section__link">Explore our products</a>
      </p>
    </div>
  </section>

  <!-- Creative Team Spotlight -->
  <TeamSection />

  <!-- Mission & Vision -->
  <section class="section mv-section">
    <div class="container mv-section__container">
      <div class="mv-section__header">
        <div class="story-section__kicker">
          <span class="story-section__kicker-sq"></span> OUR PURPOSE
        </div>
        <h2 class="mv-section__title">Mission &amp; Vision</h2>
      </div>
      <div class="story-section__divider"></div>

      <div class="mv-grid">
        <article class="mv-card">
          <span class="mv-card__num">01</span>
          <h3 class="mv-card__heading">Our Mission</h3>
          <p class="mv-card__desc">We help businesses replace manual, error-prone workflows with software that actually holds up — scalable systems that remove friction instead of adding it, built by engineers who've run their own products in production.</p>
        </article>

        <article class="mv-card">
          <span class="mv-card__num">02</span>
          <h3 class="mv-card__heading">Our Vision</h3>
          <p class="mv-card__desc">To be the engineering partner GCC and Indian businesses call first when a technology problem is too complex to hand to a template — proven not by claims, but by the platforms we've shipped and kept running.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Three Principles -->
  <PrinciplesSection />

  <!-- FAQ Section (Top 6 FAQs) -->
  <FaqSection limit={6} />

  <!-- High-End Glassmorphic CTA -->
  <section class="section about-cta-section">
    <div class="container">
      <div class="about-cta">
        <div class="about-cta__glow"></div>
        <h2 class="about-cta__title">Want to build something great together?</h2>
        <p class="about-cta__desc">Whether you have a specific software project in mind or want to explore scalable technology solutions for your business, we're ready. We respond within 24 hours.</p>
        
        <div class="about-cta__actions">
          <a href="/contact/" class="hero__pill-link">
            <span class="hero__pill-text">Start a Project</span>
            <span class="hero__pill-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </span>
          </a>
          <a href="/work/" class="about-cta__secondary-btn">See Our Work</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      function initAboutHeroScroll() {
        var statement = document.getElementById("about-hero-title");
        if (!statement) return;

        var text = statement.textContent.trim();
        var words = text.split(/\s+/);
        statement.innerHTML = words.map(function(w) {
          return '<span class="about-word">' + w + ' </span>';
        }).join('');

        var wordSpans = statement.querySelectorAll(".about-word");
        var heroSection = statement.closest(".about-hero");

        function updateProgress() {
          if (!heroSection || !wordSpans.length) return;
          var rect = heroSection.getBoundingClientRect();
          var windowH = window.innerHeight;
          
          var start = windowH * 0.85;
          var end = windowH * 0.35;
          var progress = (start - rect.top) / (start - end);
          progress = Math.max(0, Math.min(1, progress));

          var activeIndex = Math.floor(progress * wordSpans.length);
          wordSpans.forEach(function(span, idx) {
            if (idx <= activeIndex) {
              span.classList.add("is-active");
            } else {
              span.classList.remove("is-active");
            }
          });
        }

        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAboutHeroScroll);
      } else {
        initAboutHeroScroll();
      }
    })();
  </script>

  <Footer />
</Layout>

<style>
  /* DEDICATED ABOUT HERO — width via shared .container (1280px), matching landing */
  .about-hero-custom {
    padding-top: calc(80px + 2.75rem);
    padding-bottom: 2.75rem;
    background: #ffffff;
  }

  .about-hero-custom__title {
    font-size: clamp(2.2rem, 3.8vw, 3.25rem);
    font-weight: 400;
    color: #0f172a;
    font-family: var(--font-sans);
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 1rem 0 0.85rem;
    max-width: 980px;
  }

  .about-hero-custom__subtitle {
    font-size: 1.15rem;
    line-height: 1.65;
    color: #475569;
    max-width: 820px;
    margin-bottom: 2.5rem;
  }

  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
  }

  .about-stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .about-stat-card__num {
    font-size: clamp(2.2rem, 3.2vw, 3rem);
    font-weight: 500;
    color: #0f172a;
    letter-spacing: -0.03em;
    font-family: var(--font-sans);
  }

  .about-stat-card__label {
    font-size: 0.88rem;
    color: #64748b;
    font-weight: 400;
  }

  /* STORY SECTION */
  .story-section {
    padding: 3.75rem 0;
    background: #ffffff;
  }

  .story-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .story-section__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 400;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .story-section__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
  }

  .story-section__kicker-sq {
    width: 6.5px;
    height: 6.5px;
    background-color: #0284c7;
    display: inline-block;
    border-radius: 1px;
  }

  .story-section__divider {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
    margin-bottom: 2rem;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .story-card {
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .story-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.04);
    border-color: #e2e8f0;
  }

  .story-card--full {
    grid-column: 1 / -1;
  }

  .story-card--highlight {
    background: linear-gradient(135deg, #f8fafc 0%, #f0f9ff 100%);
    border-color: #e0f2fe;
  }

  .story-card__badge {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #64748b;
    text-transform: uppercase;
  }

  .story-card__badge--sky {
    color: #0284c7;
  }

  .story-card__title {
    font-size: 1.5rem;
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .story-card__text {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
  }

  .story-card__text--lead {
    font-size: 1.05rem;
    color: #334155;
  }

  .story-card__flex-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .story-card__col {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* Experience Pills */
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    margin-top: 0.75rem;
  }

  .experience-pill {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }

  .experience-pill__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .experience-pill__name {
    font-size: 1.15rem;
    font-weight: 500;
    color: #0f172a;
  }

  .experience-pill__tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: #0284c7;
    background: #f0f9ff;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
  }

  .experience-pill__role {
    font-size: 0.88rem;
    font-weight: 500;
    color: #334155;
    margin: 0;
  }

  .experience-pill__desc {
    font-size: 0.85rem;
    line-height: 1.5;
    color: #64748b;
    margin: 0;
  }

  .dubai-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: #0369a1;
    background: #e0f2fe;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    width: fit-content;
  }

  .dubai-badge__dot {
    width: 6px;
    height: 6px;
    background-color: #0284c7;
    border-radius: 50%;
  }

  /* WHAT WE DO */
  .wwd-section {
    padding: 3.75rem 0;
    background: #ffffff;
  }

  .wwd-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .wwd-section__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 400;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .wwd-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 3rem;
  }

  .wwd-item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e2e8f0;
  }

  .wwd-item__num {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #0284c7;
  }

  .wwd-item__title {
    font-size: 1.25rem;
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .wwd-item__desc {
    font-size: 1rem;
    line-height: 1.65;
    color: #475569;
    margin: 0;
    max-width: 42ch;
  }

  /* PRODUCTS WE'VE BUILT */
  .products-built-section {
    padding: 3.75rem 0;
    background: #f8fafc;
  }

  .products-built-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .products-built-section__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 400;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .products-built-section__intro {
    font-size: 1.1rem;
    line-height: 1.65;
    color: #475569;
    max-width: 52rem;
    margin: 0 0 2rem;
  }

  .products-built-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2rem;
  }

  .products-built-item {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e2e8f0;
  }

  .products-built-item__title {
    font-size: 1.25rem;
    font-weight: 450;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

