  /* ===== HOW IT WORKS ===== */
  .how-it-works {
    background: var(--white);
    padding-top: 6rem;
    padding-bottom: 6rem;
  }

  .process-interactive-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 4rem;
    max-width: 1100px;
    margin: 4rem auto 0 auto;
    position: relative;
    align-items: start;
  }

  .process-steps-column {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-step {
    display: block;
    cursor: pointer;
    opacity: 0.35;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 1.5rem 0;
    border-radius: 0;
    border: none;
    border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
    background: transparent !important;
  }

  .process-step:hover {
    opacity: 0.7;
    background: transparent !important;
  }

  .process-step.active {
    opacity: 1;
    background: transparent !important;
    border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
  }

  .step-progress-indicator {
    display: none;
  }

  .step-content {
    width: 100%;
  }

  .step-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 450;
    color: var(--gray-900);
    margin-bottom: 0;
    transition: color 0.3s ease;
  }

  .process-step.active .step-title {
    color: var(--gray-900);
  }

  .step-desc-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition:
      grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.4s ease,
      margin-top 0.4s ease;
    opacity: 0;
  }

  .process-step.active .step-desc-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.75rem;
  }

  .step-desc {
    overflow: hidden;
    font-size: 0.925rem;
    color: var(--gray-600);
    line-height: 1.6;
  }

  /* Horizontal Process Progress Bar */
  .process-progress-horizontal {
    width: 100%;
    height: 2px;
    background: var(--gray-150, rgba(226, 232, 240, 0.8));
    position: relative;
    margin-bottom: 2rem;
    border-radius: 2px;
  }

  .process-progress-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 33.33%;
    background: var(--sky-600);
    transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 2px;
  }

  /* Visual container styling */
  .process-visual-container {
    position: sticky;
    top: 150px;
    height: 400px;
