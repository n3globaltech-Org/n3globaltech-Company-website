          if (pdf) {
            btnUI.href = pdf;
            btnUI.style.display = "inline-flex";
          } else {
            btnUI.style.display = "none";
          }

          // Always use the card's cover image in Quick View.
          coverImg.src = image;
          coverImg.alt = `${name} cover`;

          const displayUrl = link || pdf;
          if (displayUrl) {
            try {
              chromeUrl.textContent = new URL(displayUrl).hostname;
            } catch (_) {
              chromeUrl.textContent = displayUrl.substring(
                displayUrl.lastIndexOf("/") + 1,
