    // Re-seed on entry so returning from another part of the page cannot inject
    // one giant velocity from the cursor's previous resting point.
    card.addEventListener(
      "pointerenter",
      (e) => {
        const point = pointerPosition(e);
        if (!point) return;
        pointerInside = true;
        px = tx = point.x;
        py = ty = point.y;
        vx = vy = 0;
      },
      { passive: true },
    );

    // Listener sits on the card, not the window — no cost anywhere else on the page.
    card.addEventListener(
      "pointermove",
      (e) => {
        const point = pointerPosition(e);
        if (!point) return;
        if (!pointerInside) {
          pointerInside = true;
          px = point.x;
          py = point.y;
        }
        tx = point.x;
        ty = point.y;
        energy = 1;
        kick();
      },
      { passive: true },
    );

    card.addEventListener(
      "pointerleave",
      () => {
        pointerInside = false;
        // Stop positional easing immediately; the existing field still fades
        // naturally, but it cannot accumulate another synthetic movement.
        tx = px;
        ty = py;
        vx = vy = 0;
      },
      { passive: true },
    );

    new IntersectionObserver(
      (entries) => {
        inView = entries[0].isIntersecting;
        kick();
      },
      { rootMargin: "120px" },
    ).observe(card);

    window.addEventListener(
      "resize",
      () => {
        resize();
        kick();
      },
      { passive: true },
    );

    if ("ResizeObserver" in window) {
      new ResizeObserver(() => {
        resize();
        kick();
      }).observe(card);
    }

    // A lost GPU context must reveal the real image instead of leaving a blank
    // or stale canvas. Reinitialisation can happen on the next page load.
    canvas.addEventListener(
      "webglcontextlost",
      (event) => {
        event.preventDefault();
        ready = false;
        card.classList.remove("is-fluid");
        if (rafId !== null) {
          cancelAnimationFrame(rafId);
          rafId = null;
        }
      },
      false,
    );

    function frame() {
      rafId = null;
      resize();

      // Ease toward the pointer rather than snapping — the velocity we derive
      // from this is what the shader injects, so smoothing it here is what makes
      // the fluid feel weighty instead of twitchy.
      const nx = px + (tx - px) * EASE;
      const ny = py + (ty - py) * EASE;
      vx = nx - px;
      vy = ny - py;
      px = nx;
      py = ny;

