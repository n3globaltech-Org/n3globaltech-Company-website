  /* Responsive styles */
  @media (max-width: 1024px) {
    .how-it-works {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }

    .process-interactive-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-top: 2rem;
    }

    .process-steps-column {
      gap: 0;
    }

    .process-step {
      display: block;
      padding: 1.25rem 0;
      border-radius: 0;
      border: none;
      border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
      background: transparent !important;
      opacity: 0.35;
      transition: opacity 0.4s ease;
    }

    .process-step.active {
      opacity: 1;
      background: transparent !important;
      border-bottom: 1px solid var(--gray-150, rgba(226, 232, 240, 0.8));
    }

    .step-progress-indicator {
      display: none;
    }

    .step-title {
      font-size: 1.35rem;
    }

    .process-visual-container {
      display: none;
    }
  }

  .launch-demo__dot {
    width: 6px;
    height: 6px;
    background: #10b981;
    border-radius: 50%;
    animation: pulse-ring 2s ease-in-out infinite;
  }

  /* ===== WHY CHOOSE US — SCROLL-DRIVEN RADIAL SHOWCASE ===== */
  .wcu {
    position: relative;
    /* One viewport of scroll per stage, plus one so the last stage gets dwell time. */
    height: 400vh;
    background: linear-gradient(
      180deg,
      #ffffff 0%,
      #f2f7fe 10%,
      #eaf2fd 50%,
      #f3f8ff 90%,
      #ffffff 100%
    );
  }

  .wcu__sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    /* The navbar is position:fixed (68px + wrapper padding), so without this the
       title scrolls underneath it. box-sizing:border-box keeps 100vh honest. */
    padding-top: 6rem;
  }

  /* --- radial wheel: centre sits off-canvas so only the right arc shows --- */
  /* Centre pushed further off-canvas than the ring, so the numbers still land at
     ~6.5vw from the viewport edge — inside the gutter .wcu__body clears, never on
     top of the copy. Biased below centre to sit against the body row rather than
     the header above it. */
  .wcu__radial {
    position: absolute;
    top: 62%;
    left: 0;
    width: 0;
    height: 0;
    transform: translate(-23vw, -50%);
    pointer-events: none;
    z-index: 0;
  }

  .wcu__ring {
    position: absolute;
    width: 52vw;
    height: 52vw;
    left: -26vw;
    top: -26vw;
    border: 1px solid rgba(14, 165, 233, 0.2);
    border-radius: 50%;
  }

  /* Wheel container stays so JS doesn't break, but no longer rotates */
  .wcu__wheel {
    position: absolute;
    width: 0;
    height: 0;
  }

  .wcu__num {
    position: absolute;
    top: 0;
    left: 0;
    /* Fixed position exactly on the right edge of the ring */
    transform: translate(26vw, -50%);
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw, 2.5rem);
    font-weight: 500;
    color: var(--gray-300);
    opacity: 0; /* Hide inactive numbers */
    pointer-events: none;
    white-space: nowrap;
    transition:
      opacity 0.5s ease,
      color 0.5s ease,
      transform 0.5s ease;
  }

  .wcu__num-inner {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
  }

  .wcu__num.is-active {
    color: var(--primary);
    opacity: 1;
    transform: translate(26vw, -50%) scale(1.05); /* Slight pop effect */
  }

  .wcu__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--primary);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease,
      box-shadow 0.45s ease;
  }
  .wcu__num.is-active .wcu__dot {
    opacity: 1;
    transform: scale(1);
    box-shadow:
      0 0 0 4px rgba(14, 165, 233, 0.16),
      0 0 14px 2px rgba(14, 165, 233, 0.5);
  }

  /* --- centre content --- */
  .wcu__inner {
    position: relative;
    z-index: 1;
  }

  .wcu__head {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  /* The body is the only part the wheel sits beside, so the left padding here
     is what keeps the numbers off the text. Numbers land at ~6vw from the
     viewport edge; this starts the content well right of that. */
  .wcu__body {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-left: clamp(0rem, 12vw, 13rem);
  }

  .wcu__content .badge {
    margin-bottom: 1rem;
  }

  /* Identical spec to .flow__title / .hero__title — now that the header spans
     the container, it can carry the full size. */
  .wcu__head h2 {
    font-family: var(--font-sans);
    font-size: var(--display-lg);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #000000;
    margin-bottom: 1.5rem;
  }

  .wcu__lede {
    color: var(--gray-500);
    line-height: 1.75;
    max-width: 52ch;
    margin-bottom: 0;
  }

  /* All four share one grid cell, so switching stages never reflows the page. */
  .wcu__stages {
    display: grid;
    min-height: 14rem;
    margin-bottom: 2rem;
  }

  .wcu__stage {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    pointer-events: none;
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.55s ease;
  }
  .wcu__stage.is-active {
    opacity: 1;
    transform: none;
    filter: none;
    pointer-events: auto;
  }

  .wcu__stage-title {
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    margin-bottom: 0.7rem;
  }

  .wcu__stage-desc {
    color: var(--gray-600);
    line-height: 1.75;
    max-width: 44ch;
    margin-bottom: 1.25rem;
  }

  .wcu__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
  }
  .wcu__tags li {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    background: #ffffff;
    border: 1px solid var(--gray-200);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--gray-700);
  }

  /* Visuals come from .hero__pill-link (same black pill as "Our Approach");
     this only owns spacing. */
  .wcu__cta {
    margin-top: 0.25rem;
  }

  /* --- right visual --- */
  .wcu__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 26rem;
  }

  /* Abstract object built from gradients only — no image payload, and it can be
     reshaped per stage by swapping the border-radius. */
  .wcu__orb {
    position: absolute;
    width: min(22vw, 18rem);
    margin-top: -3rem;
    aspect-ratio: 1;
    border-radius: 42% 58% 54% 46% / 48% 42% 58% 52%;
    background: radial-gradient(
      circle at 32% 28%,
      #ffffff 0%,
      #f4f9ff 40%,
      #dbeafe 72%,
      #c3dafc 100%
    );
    box-shadow:
      inset -18px -22px 48px rgba(37, 99, 235, 0.14),
      inset 14px 16px 40px rgba(255, 255, 255, 0.95),
      0 40px 80px -30px rgba(14, 165, 233, 0.4);
    transition:
      transform 1.1s cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 1.1s ease;
    will-change: transform;
  }

  .wcu__stats {
    position: relative;
    z-index: 1;
    display: grid;
  }

  .wcu__stat {
    grid-area: 1 / 1;
    text-align: center;
    mix-blend-mode: multiply;
    opacity: 0;
    transform: scale(0.94) translateX(14px) rotate(-1.5deg);
    pointer-events: none;
    /* Overshooting curve gives the spring feel without a physics library. */
    transition:
      opacity 0.6s ease,
      transform 0.75s cubic-bezier(0.34, 1.4, 0.5, 1);
  }
  .wcu__stat.is-active {
    opacity: 1;
    transform: scale(1) translateX(0) rotate(0deg);
    pointer-events: auto;
  }

  .wcu__stat-num {
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--sky-500), var(--sky-700));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .wcu__stat-label {
    margin-top: 0.5rem;
    color: var(--gray-500);
    font-weight: 500;
    font-size: 0.95rem;
  }

  /* --- step indicator: only shown where the wheel isn't --- */
  .wcu__steps {
    position: relative;
    z-index: 1;
    display: none;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 2.25rem;
    list-style: none;
  }
  .wcu__steps li {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--gray-300);
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    transition:
      color 0.35s ease,
      background-color 0.35s ease;
  }
  .wcu__steps li.is-active {
    color: var(--primary);
    background-color: rgba(14, 165, 233, 0.1);
  }

  /* Tablet: drop the wheel, keep the scroll stages, add the step indicator. */
  @media (max-width: 1024px) {
    .wcu__radial {
      display: none;
    }
    .wcu__body {
      padding-left: 0;
    }
    .wcu__steps {
      display: flex;
    }
    .wcu__orb {
      width: min(46vw, 20rem);
    }
  }

  /* Phone: keep the desktop's pinned, one-stage-at-a-time interaction, but
     compress the composition so the active copy and its metric share one view. */
  @media (max-width: 860px) {
    .wcu {
      height: 400svh;
    }
    .wcu__sticky {
      position: sticky;
      top: 0;
      height: 100svh;
      min-height: 100svh;
      box-sizing: border-box;
      justify-content: center;
      padding: max(5rem, calc(env(safe-area-inset-top) + 4.25rem)) 0
        max(3rem, calc(env(safe-area-inset-bottom) + 2.5rem));
      overflow: hidden;
    }
    .wcu__inner {
      width: 100%;
    }
    .wcu__head {
      margin-bottom: clamp(1.25rem, 3.5svh, 2rem);
    }
    .wcu__head h2 {
      font-size: clamp(2rem, 9.5vw, 2.75rem);
      line-height: 1.02;
      margin-bottom: 0.85rem;
    }
    .wcu__lede {
      max-width: 40rem;
      font-size: clamp(0.84rem, 3.5vw, 0.95rem);
      line-height: 1.55;
    }
    .wcu__body {
      grid-template-columns: minmax(0, 1fr) minmax(6.75rem, 29vw);
      gap: clamp(0.65rem, 3vw, 1.25rem);
      align-items: center;
    }
    .wcu__stages {
      min-height: 13.25rem;
      margin-bottom: 0.85rem;
    }
    .wcu__stage-title {
      font-size: clamp(1.25rem, 5.6vw, 1.55rem);
      margin-bottom: 0.55rem;
    }
    .wcu__stage-desc {
      font-size: clamp(0.82rem, 3.45vw, 0.95rem);
      line-height: 1.55;
      margin-bottom: 0.85rem;
    }
    .wcu__tags {
      gap: 0.4rem;
    }
    .wcu__tags li {
      padding: 0.35rem 0.65rem;
      font-size: clamp(0.68rem, 2.85vw, 0.78rem);
    }
    .wcu__cta {
      margin-top: 0;
    }
    .wcu__visual {
      min-height: 10rem;
    }
