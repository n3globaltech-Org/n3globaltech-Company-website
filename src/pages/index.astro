<script is:inline>
  (function () {
    /* ============================================================
     Work Showcase — Sticky scroll-linked card animation
     Desktop: Cards animate from stacked/rotated → side-by-side
     as the user scrolls through the 230vh .ws-scroll-track.
     Mobile: Pure CSS native layout for 120fps smooth scrolling.
  ============================================================ */

    function lerp(a, b, t) {
      return a + (b - a) * t;
    }
    function easeInOutCubic(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }
    function clamp(v, lo, hi) {
      return Math.max(lo, Math.min(hi, v));
    }
    const MOBILE_BREAKPOINT = 760;
    const isMobile = () => window.innerWidth <= MOBILE_BREAKPOINT;

    // Returns card dimensions + stacked/final position configs for desktop
    function getConfig() {
      const cW = 390;
      const cH = 345;
      const gap = 28;

      const span = cW + gap;
      return {
        cW,
        cH,
        gap,
        n: 3,
        stacked: [
          { x: -cW * 0.08, y: cH * 0.04, r: -5, z: 4, s: 1.0 },
          { x: cW * 0.1, y: -cH * 0.03, r: 7, z: 3, s: 0.94 },
          { x: cW * 0.26, y: -cH * 0.07, r: 15, z: 2, s: 0.86 },
        ],
        final: [
          { x: -span, y: 0, r: 0, z: 2, s: 1.0 }, // LEFT
          { x: 0, y: 0, r: 0, z: 1, s: 1.0 }, // CENTER
          { x: +span, y: 0, r: 0, z: 0, s: 1.0 }, // RIGHT
        ],
      };
    }

    let cfg;
    let cards = [];
    let mobile = isMobile();

    function applyCards(progress) {
      if (!cfg || mobile) return;
      const p = easeInOutCubic(clamp(progress, 0, 1));
      for (let i = 0; i < cfg.n; i++) {
        const el = cards[i];
        if (!el) continue;
        const s = cfg.stacked[i],
          f = cfg.final[i];
        const x = lerp(s.x, f.x, p);
        const y = lerp(s.y, f.y, p);
        const r = lerp(s.r, f.r, p);
        const sc = lerp(s.s, f.s, p);
        el.style.transform = `translate3d(calc(-50% + ${x.toFixed(2)}px), calc(-50% + ${y.toFixed(2)}px), 0) rotate(${r.toFixed(2)}deg) scale(${sc.toFixed(4)})`;

        const nextZ = String(Math.round(lerp(s.z, f.z, p)));
        if (el.style.zIndex !== nextZ) el.style.zIndex = nextZ;
      }
    }

    function setSizes() {
      mobile = isMobile();
      if (mobile) {
        // Clear any desktop inline styles when on mobile
        for (let i = 0; i < cards.length; i++) {
          if (cards[i]) {
            cards[i].style.width = "";
            cards[i].style.height = "";
            cards[i].style.transform = "";
            cards[i].style.top = "";
            cards[i].style.left = "";
            cards[i].style.position = "";
            cards[i].style.zIndex = "";
          }
        }
        if (stage) stage.style.height = "";
        if (inner) inner.style.transform = "";
        return;
      }

      cfg = getConfig();
      for (let i = 0; i < cfg.n; i++) {
        const el = cards[i];
        if (el) {
          el.style.width = cfg.cW + "px";
          el.style.height = cfg.cH + "px";
          el.style.top = "50%";
          el.style.left = "50%";
          el.style.position = "absolute";
        }
      }
      if (stage) {
        stage.style.height = cfg.cH + 48 + "px";
      }
    }

    let track,
      sticky,
      stage,
      cta,
      inner,
      lastP = -1;
    let scrollRaf = null;
    let resizeRaf = null;
    let showcaseActive = false;
    let ctaVisible = null;
    let lastViewportWidth = Math.round(window.innerWidth);
    let trackTop = 0;
    let scrollable = 1;

    function refreshGeometry() {
      if (!track || mobile) return;
      const scrollY = window.scrollY || window.pageYOffset;
      const rect = track.getBoundingClientRect();
      const viewportH = window.innerHeight;
      trackTop = rect.top + scrollY;
      scrollable = Math.max(1, track.offsetHeight - viewportH);
    }

    function renderScroll() {
      scrollRaf = null;
      if (!track || mobile) return;

      const scrollY = window.scrollY || window.pageYOffset;
      const raw =
        scrollable > 0 ? clamp((scrollY - trackTop) / scrollable, 0, 1) : 1;
      const progress = raw;
      const cardsChanged = Math.abs(progress - lastP) >= 0.0005;
      if (!cardsChanged) return;
      lastP = progress;

      applyCards(progress);

      if (inner) inner.style.transform = "";

      const nextCtaVisible = raw > 0.8;
      if (nextCtaVisible !== ctaVisible) {
        ctaVisible = nextCtaVisible;
        cta && cta.classList.toggle("ws-visible", ctaVisible);
      }
    }

    function onScroll() {
      if (!mobile && showcaseActive && scrollRaf === null) {
        scrollRaf = requestAnimationFrame(renderScroll);
      }
    }

    function init() {
      track = document.getElementById("ws-scroll-track");
      sticky = document.getElementById("ws-sticky");
      stage = document.getElementById("ws-stage");
      cta = document.getElementById("ws-cta");
      inner = document.getElementById("ws-sticky-inner");
      cards = [0, 1, 2].map((i) => document.getElementById("ws-card-" + i));
      mobile = isMobile();

      setSizes();
      if (!mobile) {
        applyCards(0);
        refreshGeometry();
      }

      if (track) {
        new IntersectionObserver(
          (entries) => {
            showcaseActive = entries[0].isIntersecting;
            if (showcaseActive && !mobile) {
              refreshGeometry();
              lastP = -1;
              onScroll();
            }
          },
          { rootMargin: "120px 0px" },
        ).observe(track);
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener(
        "resize",
        () => {
          const nextWidth = Math.round(window.innerWidth);
          const widthChanged = Math.abs(nextWidth - lastViewportWidth) > 1;

          if (!widthChanged) return;
          if (resizeRaf !== null) cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(() => {
            resizeRaf = null;
            lastViewportWidth = nextWidth;
            mobile = isMobile();
            setSizes();
            if (!mobile) {
              refreshGeometry();
              lastP = -1;
              onScroll();
            }
          });
        },
        { passive: true },
      );

      window.addEventListener(
        "load",
        () => {
          if (!mobile) {
            refreshGeometry();
            lastP = -1;
            onScroll();
          }
        },
        { once: true },
      );

      if (!mobile) {
        renderScroll();
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
