    display: block;
    overflow: hidden;
    /* The WebGL canvas has a large intrinsic bitmap size on high-DPI screens.
       Keep that intrinsic size out of layout, otherwise some browsers feed the
       new canvas dimensions back into the card and grow it on every hover. */
    contain: layout paint;
    will-change: transform;
    transform: translateZ(0);
  }

  /* Absolute layers make the card the only source of layout dimensions. */
  .flow__card > img,
  .flow__card > canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
  }

  /* cover, so the warp crops into the photo instead of exposing a gap where a
     background used to be. */
  .flow__card > img {
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .flow__card > canvas {
    opacity: 0;
    contain: strict;
    /* Never intercepts clicks, hover or scroll — the effect is decoration only. */
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  /* WebGL took over: the canvas paints, the <img> goes transparent but stays in
     the layout and the a11y tree so its alt text is still exposed. */
  .flow__card.is-fluid > canvas {
    opacity: 1;
  }
  .flow__card.is-fluid > img {
    opacity: 0;
  }

  .flow__desc {
    font-family: var(--font-sans);
    font-size: var(--body-lg);
    line-height: 1.45;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  @media (max-width: 860px) {
    .flow__body {
      grid-template-columns: 1fr;
    }

    /* Mobile gets a quicker reveal and a static decorative path. The desktop
       scroll-linked parallax remains unchanged. */
    .flow__line > g {
      filter: none;
    }
    .flow__title .word {
      transition-duration: 0.5s;
      transition-delay: calc(var(--i) * 30ms);
    }
    .flow__desc .word {
      transition-duration: 0.35s;
      transition-delay: calc(var(--i) * 7ms);
    }
    .flow__cta {
      transition:
        opacity 0.4s ease 0.12s,
        transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.12s,
        box-shadow 0.25s ease;
    }
  }

  /* Everything resolves to its final state; nothing moves. */
  @media (prefers-reduced-motion: reduce) {
    .flow__card {
      clip-path: none;
    }
    .flow__card img {
      transform: none;
    }
    .flow__title .word,
    .flow__desc .word,
    .flow__cta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* ===== SERVICES GRID ===== */
