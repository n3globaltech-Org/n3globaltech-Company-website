<Layout
  title="N3 Global Tech (N3GlobalTech) | Software Development Company in Kannur, Kerala"
  description="Custom software development company in Kannur, Kerala building scalable web apps, mobile apps, cloud platforms, and SaaS products. Trusted global partner."
  keywords="software development company in kannur, software company in kerala, custom software development, web development services, mobile app development, cloud solutions, SaaS development, AI development, UI UX design, MVP development, digital transformation, startup tech partner"
  faqs={faqs}
>
  <Navbar />

  <!-- ========== HERO ========== -->
  <section class="hero hero--fullscreen-video" data-cursor-hidden>
    <div class="hero__video-bg">
      <div class="hero__media">
        <!-- This is the video's real first frame. Keeping it as a separate layer
             prevents iOS from drawing its native play badge over the loading UI. -->
        <img
          class="hero-video-poster"
          src="/land-vid-poster.webp"
          width="1280"
          height="724"
          alt=""
          aria-hidden="true"
          fetchpriority="high"
          decoding="sync"
          draggable="false"
        />

        <!-- Keep autoplay in the initial markup for mobile Safari. Adding it only
             from JavaScript can leave iOS showing its native play overlay. The
             separate poster above covers the video until a frame is playing. -->
        <video
          id="hero-video"
          class="hero-video-full"
          src="/land-vid-mobile.mp4"
          autoplay
          muted
          playsinline
          webkit-playsinline
          loop
          preload="auto"
          poster="/land-vid-poster.webp"
          aria-hidden="true"></video>
        <script is:inline>
          (function () {
            var v = document.getElementById("hero-video");
            if (!v) return;
            var media = v.closest(".hero__media");
            var fine = window.matchMedia("(pointer: fine)").matches;
            var reduced = window.matchMedia(
              "(prefers-reduced-motion: reduce)",
            ).matches;
            var revealQueued = false;

            // Only uncover the video once the browser has actually presented a
            // decoded frame. requestVideoFrameCallback avoids the white/black
            // flash that can occur between `loadeddata` and the first paint.
            function revealVideo() {
              if (!media || revealQueued) return;
              revealQueued = true;

              var reveal = function () {
                media.classList.add("hero__media--video-visible");
              };

              if (typeof v.requestVideoFrameCallback === "function") {
                v.requestVideoFrameCallback(reveal);
              } else {
                requestAnimationFrame(function () {
                  requestAnimationFrame(reveal);
                });
              }
            }

            if (fine) {
              // Desktop is paused for pointer scrubbing, so its first decoded
              // frame is enough. Touch waits for `playing` so a failed autoplay
              // simply leaves the clean poster visible.
              v.addEventListener("loadeddata", revealVideo, { once: true });
            } else if (!reduced) {
              v.addEventListener("playing", revealVideo, { once: true });
            }

            if (!fine && !reduced) {
              // Mirror the parsed attributes as properties for older WebKit builds
              // as well. defaultMuted reflects the video's initial muted state.
              v.defaultMuted = true;
              v.muted = true;
              v.playsInline = true;
              v.setAttribute("playsinline", "");
              v.setAttribute("webkit-playsinline", "");
              // Native autoplay is far more reliable on iOS than a deferred play().
              v.autoplay = true;
            } else {
              // Desktop uses pointer-driven scrubbing; reduced-motion users keep
              // the static first frame.
              v.autoplay = false;
              v.removeAttribute("autoplay");
            }

            // Touch gets the high-quality ping-pong encode (forward + reversed,
            // so a plain `loop` rewinds seamlessly). Fine pointers use the shorter
            // all-intra file required by the desktop scrub interaction.
            if (fine) v.src = "/land-vid.mp4";

            if (fine && v.readyState >= 2) revealVideo();
            if (!fine && !reduced && !v.paused && v.readyState >= 2) {
              revealVideo();
            }
          })();
        </script>
      </div>
    </div>

    <div class="hero__glow hero__glow--1" style="z-index: 1; opacity: 0.5;">
    </div>
    <div class="hero__glow hero__glow--2" style="z-index: 1; opacity: 0.5;">
    </div>

    <div class="container hero__inner" style="z-index: 2; position: relative;">
      <div class="hero__content">
        <h1 class="hero__title animate-fade-up" style="animation-delay:0.1s">
