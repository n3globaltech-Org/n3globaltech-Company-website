      // Hero video scrub logic — pointer-driven seeking.
      // Seeking a compressed video is only cheap when the target is buffered, so we
      // gate on buffered ranges and ease toward the target instead of chasing the
      // raw pointer position (a fast flick would otherwise demand a long seek every frame).
      const heroVid = document.getElementById("hero-video");
      const finePointer = window.matchMedia("(pointer: fine)").matches;
      const reducedMotion = window.matchMedia(
