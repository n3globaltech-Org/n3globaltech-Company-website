                />
              </div>
              <div class="ws-card__meta">
                <strong class="ws-card__name">Enjoyful Life</strong>
                <p class="ws-card__desc">
                  Natural skincare e-commerce, built for scale.
                </p>
              </div>
            </div>

            <!-- Card 2: Flyger (RIGHT) -->
            <div
              class="ws-card"
              id="ws-card-2"
              style="cursor: pointer;"
              data-name="Flyger Aviation Services"
              data-category="Aviation Services"
              data-desc="A professional corporate website for a global aviation support provider specializing in end-to-end flight operations. The site showcases their flight planning, permit acquisition, dispatch coordination, and crew logistics services with a clean, premium UI tailored for international operators."
              data-tech="Modern Web Stack"
              data-client="Flyger Aviation Services"
              data-status="Live"
              data-link="https://flyger.aero"
              data-pdf=""
              data-image="/products/circle-for-work/svg/flygercover.webp"
            >
              <div class="ws-card__img">
                <img
                  src="/products/circle-for-work/svg/flygercover.webp"
                  srcset="/products/circle-for-work/svg/flygercover-480.webp 480w, /products/circle-for-work/svg/flygercover-900.webp 900w, /products/circle-for-work/svg/flygercover.webp 1536w"
                  sizes="(max-width: 760px) 280px, 390px"
                  width="900"
                  height="600"
                  alt="Flyger Aviation Services"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="ws-card__meta">
                <strong class="ws-card__name">Flyger Aviation</strong>
                <p class="ws-card__desc">
                  Global aviation support portal, live in production.
                </p>
              </div>
            </div>
          </div>

          <!-- CTA -->
          <div class="ws-cta" id="ws-cta">
            <a
              href="/work/"
              class="btn btn-outline btn-lg ws-cta__button cta-dark-pill"
            >
              <span>See All Projects</span>
              <span class="cta-dark-pill__icon" aria-hidden="true"
                ><svg
                  width="16"
                  height="16"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M7 17 17 7m0 0H7m10 0v10"></path></svg
                ></span
              >
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ========== HOW WE WORK ========== -->
    <HowWeWork />








