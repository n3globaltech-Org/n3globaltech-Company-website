          if (!isBuffered(easedTime)) return;

          if (Math.abs(heroVid.currentTime - easedTime) > 0.02) {
            if (canFastSeek) heroVid.fastSeek(easedTime);
            else heroVid.currentTime = easedTime;
          }
        }
      }

      // Touch devices have no cursor to scrub with, so the scrub block above never
      // runs and nothing would ever paint a frame. Play it as a plain background
      // loop instead. muted + playsinline is what makes a programmatic play()
      // permissible under mobile autoplay policy; if it's still refused the poster
