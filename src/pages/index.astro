                  srcset="/products/circle-for-work/svg/enjoyfullifecover-480.webp 480w, /products/circle-for-work/svg/enjoyfullifecover-900.webp 900w, /products/circle-for-work/svg/enjoyfullifecover.webp 1536w"
                  sizes="(max-width: 760px) 280px, 390px"
