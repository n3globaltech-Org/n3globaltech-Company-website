  /* ===== WHAT N3 STANDS FOR / PRINCIPLES ===== */
  .principles-section {
    background: #ffffff;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .principles__line {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .principles__inner {
    position: relative;
    z-index: 1;
  }

  .principles__head {
    max-width: 900px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .principles__head .badge {
    margin-bottom: 1.25rem;
  }

  /* Same type spec as the hero and flow titles. */
  .principles__title {
    font-family: var(--font-sans);
    font-size: var(--display-lg);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: #000000;
    margin-bottom: 1.5rem;
  }

  .principles__row {
    display: block;
    overflow: hidden;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }

  .principles__title .word {
    transform: translate3d(0, 110%, 0);
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(var(--i) * 60ms);
  }
  .principles-section.is-visible .principles__title .word {
    transform: translate3d(0, 0, 0);
  }

  .principles__lede {
    color: var(--gray-500);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .principles__title .word {
      transform: none;
      transition: none;
    }
  }

  /* Staggered left / right / left so the stroke weaves between the three N's
     instead of running behind a flat row of them. */
  .principles-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 4.5rem);
    max-width: 1040px;
    margin: clamp(2.5rem, 6vw, 5rem) auto 0;
  }

  .principles-grid .principle-card {
    width: min(100%, 430px);
  }
  .principles-grid .principle-card:nth-child(1) {
    align-self: flex-start;
  }
  .principles-grid .principle-card:nth-child(2) {
    align-self: flex-end;
  }
  .principles-grid .principle-card:nth-child(3) {
    align-self: flex-start;
  }

  @media (max-width: 720px) {
    .principles-grid .principle-card,
    .principles-grid .principle-card:nth-child(n) {
      width: 100%;
      align-self: stretch;
    }
  }

  .principle-card {
    position: relative;
    background: #ffffff;
    border: 1.5px solid var(--gray-100);
    border-radius: var(--radius-xl);
    padding: 2.25rem 2rem 2rem;
