          clipPath.setAttribute(
            "d",
            `M 0,${TOP} C 0.33,${t} 0.67,${t} 1,${TOP} L 1,${BOTTOM} C 0.67,${b} 0.33,${b} 0,${BOTTOM} Z`,
          );
        };

        const wake = () => {
          if (inView && rafId === null) rafId = requestAnimationFrame(tickFlow);
        };

        // Reveal fires once; the CSS transitions handle the stagger from here.
        const revealIO = new IntersectionObserver(
          (entries) => {
            if (entries[0].isIntersecting) {
              flow.classList.add("is-visible");
              revealIO.disconnect();
            }
          },
          mobileFlow
            ? { threshold: 0.01, rootMargin: "160px 0px" }
            : { threshold: 0.15 },
        );
        revealIO.observe(flow);

        // Touch devices keep the lightweight blue line-draw effect, but skip the
        // parallax, card skew, cursor droplets and clip-path rewriting that caused
        // delayed updates during momentum scrolling.
        if (mobileFlow) {
          let mobileLineInView = false;
          let mobileLineRaf = null;

          const drawMobileLine = () => {
            mobileLineRaf = null;
            const rect = flow.getBoundingClientRect();
            const vh = window.innerHeight;
            const progress = Math.max(
              0,
              Math.min(1, (vh - rect.top) / (vh + rect.height)),
            );
            linePath.style.strokeDashoffset = String(lineLen * (1 - progress));
          };

          const queueMobileLine = () => {
            if (mobileLineInView && mobileLineRaf === null) {
              mobileLineRaf = requestAnimationFrame(drawMobileLine);
            }
          };

          new IntersectionObserver(
            (entries) => {
              mobileLineInView = entries[0].isIntersecting;
              queueMobileLine();
            },
            { rootMargin: "160px 0px" },
          ).observe(flow);

          window.addEventListener("scroll", queueMobileLine, { passive: true });
          drawMobileLine();
          return;
        }

        // Scroll-linked work only runs while the section is near the viewport.
        const activeIO = new IntersectionObserver(
          (entries) => {
            inView = entries[0].isIntersecting;
            wake();
          },
          { rootMargin: "200px 0px" },
        );
        activeIO.observe(flow);

        window.addEventListener("scroll", wake, { passive: true });

        // Coarse pointers get no droplets — there's no hover state to drive them.
        if (window.matchMedia("(pointer: fine)").matches) {
          flow.addEventListener(
            "pointermove",
            (e) => {
              pointerX = e.clientX;
              pointerY = e.clientY;
              pointerLive = true;
              wake();
            },
            { passive: true },
          );

          flow.addEventListener(
            "pointerleave",
            () => {
              pointerLive = false;
              wake();
            },
            { passive: true },
          );
        }

        function tickFlow() {
          rafId = null;

          const y = window.scrollY;
          const raw = y - lastScroll;
          lastScroll = y;
          velocity += (raw - velocity) * 0.12;

          const rect = flow.getBoundingClientRect();
          const vh = window.innerHeight;

          // 0 -> 1 as the section travels from just below to just above the viewport
          const progress = Math.max(
            0,
            Math.min(1, (vh - rect.top) / (vh + rect.height)),
          );

          linePath.style.strokeDashoffset = String(lineLen * (1 - progress));

          // Centered so each layer drifts through zero at mid-scroll, not from the top.
          const centered = (progress - 0.5) * 2;
          for (const el of layers) {
            const rate = parseFloat(el.dataset.rate) || 0;
            el.style.transform = `translate3d(0, ${(centered * rate * -vh).toFixed(2)}px, 0)`;
          }

          // Rewriting the clipPath `d` re-rasterises the clip every frame, which is
          // the single most expensive thing in this loop. Worth it on desktop; on a
          // phone it's a major source of scroll jank, so skip it there and keep only
          // the compositor-only skew.
          if (canWarp) {
            const bow = Math.max(-0.05, Math.min(0.05, velocity * 0.0018));
            setWarp(bow);
          }
          const cardSkew = Math.max(
            -2.4,
            Math.min(2.4, velocity * 0.011),
          );
          card.style.transform = `translateZ(0) skewY(${cardSkew.toFixed(3)}deg)`;

          // --- liquid droplets ---
          activity += ((pointerLive ? 1 : 0) - activity) * 0.09;
          let trailMoving = false;

          if (activity > 0.002) {
            // getScreenCTM handles the viewBox + preserveAspectRatio="slice" mapping
            // for us, which hand-rolled math would get wrong on off-ratio viewports.
            const ctm = lineSvg.getScreenCTM();
            if (ctm) {
              const p = new DOMPoint(pointerX, pointerY).matrixTransform(
                ctm.inverse(),
              );

              // Drop the whole chain onto the cursor on entry, so it doesn't whip
              // across the section from its last resting place.
              if (!seeded) {
                for (const t of trail) {
                  t.x = p.x;
                  t.y = p.y;
                }
                seeded = true;
              }

              trail[0].x += (p.x - trail[0].x) * 0.34;
              trail[0].y += (p.y - trail[0].y) * 0.34;
              for (let i = 1; i < trail.length; i++) {
                trail[i].x += (trail[i - 1].x - trail[i].x) * 0.3;
                trail[i].y += (trail[i - 1].y - trail[i].y) * 0.3;
              }

              for (let i = 0; i < blobEls.length; i++) {
                const taper = 1 - i / (blobEls.length + 1);
                blobEls[i].setAttribute("cx", trail[i].x.toFixed(1));
                blobEls[i].setAttribute("cy", trail[i].y.toFixed(1));
                blobEls[i].setAttribute(
                  "r",
                  (BLOB_R * taper * activity).toFixed(1),
                );
              }

              const tail = trail[trail.length - 1];
              trailMoving = Math.hypot(tail.x - p.x, tail.y - p.y) > 0.6;
            }
          } else if (seeded) {
            for (const el of blobEls) el.setAttribute("r", "0");
            seeded = false;
          }

          // Sleep once scrolling stops, the warp has sprung back, and the
          // droplets have either caught up or fully drained.
          const settling = pointerLive ? activity < 0.998 : activity > 0.002;
          const idle =
            Math.abs(raw) < 0.05 &&
            Math.abs(velocity) < 0.05 &&
            !trailMoving &&
            !settling;

          if (!idle) rafId = requestAnimationFrame(tickFlow);
        }

        // Run one pass synchronously rather than via wake(): wake() is gated on
        // inView, which is still false until the observer first fires, so the
        // parallax layers would sit un-offset and jump on the first scroll.
        tickFlow();
      }
    } catch (err) {
      console.error("[init:flow]", err);
    }
  });

  // Independent listener: a throw here cannot stop the blocks below.
  document.addEventListener("DOMContentLoaded", () => {
    try {
      // ===== Principles: draw the 3 of N3 as the section scrolls past =====
      const prin = document.getElementById("principles");

      if (
        prin &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const prinPath = document.getElementById("principles-line-path");

        const prinLen = prinPath.getTotalLength();
        prinPath.style.strokeDasharray = String(prinLen);
        prinPath.style.strokeDashoffset = String(prinLen);

        let prinIn = false;
        let prinRaf = null;
        let prinBound = false;
        const mobilePrinciples =
          window.innerWidth <= 760 ||
          window.matchMedia("(pointer: coarse)").matches;

        const prinWake = () => {
          if (prinIn && prinRaf === null)
            prinRaf = requestAnimationFrame(tickPrin);
        };

        new IntersectionObserver(
          (entries) => {
            prinIn = entries[0].isIntersecting;
            if (prinIn && !prinBound) {
              window.addEventListener("scroll", prinWake, { passive: true });
              prinBound = true;
            } else if (!prinIn && prinBound) {
              window.removeEventListener("scroll", prinWake);
              prinBound = false;
            }
            prinWake();
          },
          mobilePrinciples
            ? { rootMargin: "0px 0px -8% 0px" }
            : { rootMargin: "200px 0px" },
        ).observe(prin);

        function tickPrin() {
          prinRaf = null;
          const r = prin.getBoundingClientRect();
          const vh = window.innerHeight;
          const p = Math.max(0, Math.min(1, (vh - r.top) / (vh + r.height)));
          prinPath.style.strokeDashoffset = String(prinLen * (1 - p));
          // Purely scroll-driven, so one pass per scroll event is enough.
        }

        tickPrin();
      }
    } catch (err) {
      console.error("[init:principles]", err);
    }
  });

  // Independent listener: a throw here cannot stop the blocks below.
  document.addEventListener("DOMContentLoaded", () => {
    try {
      // ===== Why Choose Us: scroll position -> active stage =====
      // No scroll hijacking: we only read scrollTop and toggle classes. The page
      // scrolls normally; position:sticky does all the pinning.
      const wcu = document.getElementById("wcu");

      if (
        wcu &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const wheel = document.getElementById("wcu-wheel");
        const orb = document.getElementById("wcu-orb");
        const nums = Array.from(wcu.querySelectorAll(".wcu__num"));
        const stages = Array.from(wcu.querySelectorAll(".wcu__stage"));
        const stats = Array.from(wcu.querySelectorAll(".wcu__stat"));
        const steps = Array.from(wcu.querySelectorAll(".wcu__steps li"));
        const COUNT = stages.length;

        // Each stage reshapes the orb slightly so the visual isn't static.
        const ORB_SHAPES = [
          "42% 58% 54% 46% / 48% 42% 58% 52%",
          "58% 42% 44% 56% / 42% 56% 44% 58%",
          "48% 52% 62% 38% / 56% 44% 56% 44%",
          "52% 48% 40% 60% / 44% 58% 42% 56%",
        ];

        let current = -1;
        let ticking = false;

        function apply(stage) {
          if (stage === current) return;
          current = stage;

          // Unitless: the CSS multiplies it by 1deg. ~90 degrees per stage.
          wheel.style.setProperty("--wheel", String(-stage * 90));

          for (let i = 0; i < COUNT; i++) {
            nums[i] && nums[i].classList.toggle("is-active", i === stage);
            stages[i].classList.toggle("is-active", i === stage);
            stats[i] && stats[i].classList.toggle("is-active", i === stage);
            steps[i] && steps[i].classList.toggle("is-active", i === stage);
          }

          if (orb) {
            orb.style.borderRadius = ORB_SHAPES[stage];
            orb.style.transform = `rotate(${stage * 24}deg) scale(${1 + stage * 0.015})`;
          }
        }

        function measure() {
          const rect = wcu.getBoundingClientRect();
          // Distance scrolled through the track, over the distance the sticky
          // child can travel inside it.
          const travel = rect.height - window.innerHeight;
          if (travel <= 0) {
            apply(0);
            return;
          }
          const p = Math.min(Math.max(-rect.top / travel, 0), 1);
          // 0.999 keeps p === 1 from indexing past the last stage.
          apply(Math.min(Math.floor(p * COUNT * 0.999), COUNT - 1));
        }

        // rAF-coalesced: many scroll events collapse into one read per frame.
        function onScroll() {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            measure();
          });
        }

        // Only listen while the section is anywhere near the viewport.
        let bound = false;
        new IntersectionObserver(
          (entries) => {
            const vis = entries[0].isIntersecting;
            if (vis && !bound) {
              window.addEventListener("scroll", onScroll, { passive: true });
              bound = true;
              measure();
            } else if (!vis && bound) {
              window.removeEventListener("scroll", onScroll);
              bound = false;
            }
          },
          { rootMargin: "10% 0px" },
        ).observe(wcu);

        window.addEventListener("resize", measure, { passive: true });
        measure();
      }
    } catch (err) {
      console.error("[init:wcu]", err);
    }
  });
</script>

<!-- ===================================================================
     Mouse-driven fluid distortion on the flow card (raw WebGL2).

     Two passes per frame:
       1. Flow map  — a low-res ping-pong buffer. The cursor injects velocity
                      into it; each frame the previous buffer is faded and fed
                      back, which is what leaves a trail behind the pointer.
       2. Display   — samples the photo with UVs pushed by the flow map, and
                      splits R/B further apart where the flow is strongest.

     Deliberately no three.js: this needs two FBOs and a fullscreen triangle,
     not a scene graph. ~4KB here versus ~150KB gzipped for the library.
     ================================================================== -->
<script is:inline>
  (function () {
    const card = document.getElementById("flow-card");
    const canvas = document.getElementById("flow-fluid");
    const img = document.getElementById("flow-img");
    if (!card || !canvas || !img) return;

    // ---- bail-out conditions: leave the plain <img> in place ----
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!window.matchMedia("(pointer: fine)").matches) return;
    // Weak hardware: a 2-pass GPU effect isn't worth the battery.
    if ((navigator.hardwareConcurrency || 4) < 4) return;
    if (navigator.deviceMemory && navigator.deviceMemory < 4) return;

    const gl = canvas.getContext("webgl2", {
      alpha: true,
      antialias: false,
      depth: false,
      stencil: false,
      premultipliedAlpha: false,
      powerPreference: "low-power",
    });
    if (!gl) return;

    // Flow simulation runs far below display res — it's a smooth vector field,
    // so extra resolution buys nothing but fill rate.
    const SIM = 128;
    const MAX_DPR = 1.75;
    const DECAY = 0.955; // per-frame trail persistence
    const RADIUS = 0.16; // cursor injection falloff
    const STRENGTH = 0.055; // max UV displacement
    const CHROMA = 0.45; // RGB separation, scaled by local flow
    const EASE = 0.14; // pointer smoothing

    const VERT = `#version 300 es
      const vec2 P[3] = vec2[3](vec2(-1.0,-1.0), vec2(3.0,-1.0), vec2(-1.0,3.0));
      out vec2 vUv;
      void main() {
        vec2 p = P[gl_VertexID];
        vUv = p * 0.5 + 0.5;
        gl_Position = vec4(p, 0.0, 1.0);
      }`;

    // Flow is signed but stored in RGBA8 (encoded to 0..1) rather than a float
    // target — avoids depending on EXT_color_buffer_float for renderability.
    const SIM_FRAG = `#version 300 es
      precision highp float;
      in vec2 vUv;
      out vec4 outColor;
      uniform sampler2D uPrev;
      uniform vec2 uCursor;
      uniform vec2 uVel;
      uniform float uAspect;
      uniform float uDecay;
      uniform float uRadius;
      void main() {
        vec2 prev = texture(uPrev, vUv).xy * 2.0 - 1.0;
        vec2 d = vUv - uCursor;
        d.x *= uAspect;
        float fall = exp(-dot(d, d) / (uRadius * uRadius));
        vec2 flow = prev * uDecay + uVel * fall;
        flow = clamp(flow, -1.0, 1.0);
        outColor = vec4(flow * 0.5 + 0.5, 0.0, 1.0);
      }`;

    const DRAW_FRAG = `#version 300 es
      precision highp float;
      in vec2 vUv;
      out vec4 outColor;
      uniform sampler2D uImage;
      uniform sampler2D uFlow;
      uniform float uCanvasAspect;
      uniform float uImageAspect;
      uniform float uStrength;
      uniform float uChroma;
      void main() {
        // object-fit: cover, matching the CSS on the <img> it replaces. Crops
        // rather than letterboxes, so there's never a transparent gap.
        vec2 s = vec2(1.0);
        if (uCanvasAspect > uImageAspect) s.y = uImageAspect / uCanvasAspect;
        else s.x = uCanvasAspect / uImageAspect;
        vec2 uv = (vUv - 0.5) * s + 0.5;

        vec2 flow = texture(uFlow, vUv).xy * 2.0 - 1.0;
        float mag = min(length(flow), 1.0);
        vec2 off = flow * uStrength;

        // Chromatic split widens only where the fluid is actually moving.
        float ca = uChroma * mag;
        vec2 rUv = uv + off * (1.0 + ca);
        vec2 gUv = uv + off;
        vec2 bUv = uv + off * (1.0 - ca);

        // cover always fills, so no transparency mask is needed.
        outColor = vec4(
          texture(uImage, clamp(rUv, 0.0, 1.0)).r,
          texture(uImage, clamp(gUv, 0.0, 1.0)).g,
          texture(uImage, clamp(bUv, 0.0, 1.0)).b,
          1.0
        );
      }`;

    function compile(type, src) {
      const sh = gl.createShader(type);
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
        console.warn("[fluid] shader:", gl.getShaderInfoLog(sh));
        return null;
      }
      return sh;
    }

    function program(fragSrc) {
      const vs = compile(gl.VERTEX_SHADER, VERT);
      const fs = compile(gl.FRAGMENT_SHADER, fragSrc);
      if (!vs || !fs) return null;
      const p = gl.createProgram();
      gl.attachShader(p, vs);
      gl.attachShader(p, fs);
      gl.linkProgram(p);
      gl.deleteShader(vs);
      gl.deleteShader(fs);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
        console.warn("[fluid] link:", gl.getProgramInfoLog(p));
        return null;
      }
      return p;
    }

    const simProg = program(SIM_FRAG);
    const drawProg = program(DRAW_FRAG);
    if (!simProg || !drawProg) return;

    const U = (p, names) => {
      const o = {};
      for (const n of names) o[n] = gl.getUniformLocation(p, n);
      return o;
    };
    const simU = U(simProg, [
      "uPrev",
      "uCursor",
      "uVel",
      "uAspect",
      "uDecay",
      "uRadius",
    ]);
    const drawU = U(drawProg, [
      "uImage",
      "uFlow",
      "uCanvasAspect",
      "uImageAspect",
      "uStrength",
      "uChroma",
    ]);

    // gl_VertexID drives the fullscreen triangle, so no buffers are needed —
    // but a VAO must still be bound for the draw call to be valid.
    gl.bindVertexArray(gl.createVertexArray());

    function makeTarget() {
      const tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(
        gl.TEXTURE_2D,
        0,
        gl.RGBA,
        SIM,
        SIM,
        0,
        gl.RGBA,
        gl.UNSIGNED_BYTE,
        null,
      );
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      const fbo = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
      gl.framebufferTexture2D(
        gl.FRAMEBUFFER,
        gl.COLOR_ATTACHMENT0,
        gl.TEXTURE_2D,
        tex,
        0,
      );
      // Neutral flow = 0.5 once decoded back to signed.
      gl.clearColor(0.5, 0.5, 0.0, 1.0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      return { tex, fbo };
    }

    let a = makeTarget();
    let b = makeTarget();
    gl.bindFramebuffer(gl.FRAMEBUFFER, null);

    const imgTex = gl.createTexture();
    let imageAspect = 1.5;
    let ready = false;

    function uploadImage() {
      if (!img.naturalWidth) return;
      imageAspect = img.naturalWidth / img.naturalHeight;
      gl.bindTexture(gl.TEXTURE_2D, imgTex);
      gl.pixelStorei(gl.UNPACK_FLIP_Y_WEBGL, true);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      ready = true;
      card.classList.add("is-fluid");
      kick();
    }

    let cw = 1;
    let ch = 1;
    function resize() {
      // Measure the stable parent, never the canvas whose intrinsic bitmap size
      // is changed below. This prevents high-DPI resize feedback loops.
      const r = card.getBoundingClientRect();
      if (!r.width || !r.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      const w = Math.max(1, Math.round(r.width * dpr));
      const h = Math.max(1, Math.round(r.height * dpr));
      if (w === cw && h === ch) return;
      cw = w;
      ch = h;
      canvas.width = w;
      canvas.height = h;
    }

    // Pointer state, in canvas-normalised coords.
    let px = 0.5,
      py = 0.5; // eased position
    let tx = 0.5,
      ty = 0.5; // raw target
    let vx = 0,
      vy = 0;
    let energy = 0; // proxy for "is the field still alive"
    let rafId = null;
    let inView = false;
    let pointerInside = false;

