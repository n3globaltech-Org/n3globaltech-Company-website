      gl.bindFramebuffer(gl.FRAMEBUFFER, b.fbo);
      gl.viewport(0, 0, SIM, SIM);
      gl.useProgram(simProg);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, a.tex);
      gl.uniform1i(simU.uPrev, 0);
      gl.uniform2f(simU.uCursor, px, 1.0 - py); // GL origin is bottom-left
      // Cap a very fast mouse/trackpad event so the image can ripple but never
      // appear to zoom or stretch out of its frame.
      gl.uniform2f(
        simU.uVel,
        Math.max(-0.75, Math.min(0.75, vx * 9.0)),
        Math.max(-0.75, Math.min(0.75, -vy * 9.0)),
      );
      gl.uniform1f(simU.uAspect, aspect);
      gl.uniform1f(simU.uDecay, DECAY);
      gl.uniform1f(simU.uRadius, RADIUS);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      const t = a;
      a = b;
      b = t; // ping-pong

      // --- pass 2: draw the distorted image ---
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, cw, ch);
      gl.useProgram(drawProg);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, imgTex);
      gl.uniform1i(drawU.uImage, 0);
      gl.activeTexture(gl.TEXTURE1);
      gl.bindTexture(gl.TEXTURE_2D, a.tex);
      gl.uniform1i(drawU.uFlow, 1);
      gl.uniform1f(drawU.uCanvasAspect, aspect);
      gl.uniform1f(drawU.uImageAspect, imageAspect);
      gl.uniform1f(drawU.uStrength, STRENGTH);
      gl.uniform1f(drawU.uChroma, CHROMA);
      gl.drawArrays(gl.TRIANGLES, 0, 3);

      // Keep going while the trail is still visibly decaying, then stop dead.
      energy *= DECAY;
      const moving = Math.abs(tx - px) > 0.0006 || Math.abs(ty - py) > 0.0006;
      if (inView && (moving || energy > 0.012))
        rafId = requestAnimationFrame(frame);
    }

    // Drop the GPU work entirely if the tab is backgrounded.
    document.addEventListener("visibilitychange", () => {
      if (document.hidden && rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      } else kick();
    });

    resize();
    if (img.complete && img.naturalWidth) uploadImage();
    else img.addEventListener("load", uploadImage, { once: true });
  })();
</script>

<script is:inline>
  (function () {
    var statement = document.getElementById("about-preview-title");
    if (!statement) return;

    var text = statement.textContent.trim();
    var words = text.split(/\s+/);
    statement.innerHTML = words
      .map(function (w) {
        return '<span class="about-word">' + w + "</span>";
      })
      .join(" ");

    var wordSpans = statement.querySelectorAll(".about-word");
    var total = wordSpans.length;

    function updateWordHighlight() {
      var section = statement.closest(".about-preview");
      if (!section) return;

      var rect = section.getBoundingClientRect();
      var vh = window.innerHeight;

      // Start highlighting when top of section comes up to 80% viewport height
      // Finish highlighting when top reaches 20% viewport height
      var startY = vh * 0.8;
      var endY = vh * 0.2;
      var progress = (startY - rect.top) / (startY - endY);
      progress = Math.max(0, Math.min(1, progress));

      var activeCount = Math.floor(progress * (total + 1));
      for (var i = 0; i < total; i++) {
        if (i < activeCount) {
          wordSpans[i].classList.add("is-active");
        } else {
          wordSpans[i].classList.remove("is-active");
        }
      }
    }

    window.addEventListener("scroll", updateWordHighlight, { passive: true });
    window.addEventListener("resize", updateWordHighlight, { passive: true });
    updateWordHighlight();
  })();
</script>
