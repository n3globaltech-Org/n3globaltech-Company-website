---
const members = [
  {
    name: "Nibras",
    role: "Founder & CEO",
    image: "/team/nibras.webp",
  },
  {
    name: "Nabeel",
    role: "Co-founder & CTO",
    image: "/team/nabeel.webp",
  },
  {
    name: "Nafi",
    role: "Co-founder",
    image: "/team/nafi.webp",
  },
  {
    name: "Farseen",
    role: "Co-founder",
    image: "/team/farseen.webp",
  },
];
---

<section class="team-accordion" id="team" aria-labelledby="team-accordion-title">
  <div class="container team-accordion__inner">
    <div class="team-accordion__header">
      <span class="team-accordion__badge">Our Team</span>
      <h2 class="team-accordion__title" id="team-accordion-title">The minds behind N3</h2>
      <p class="team-accordion__subtitle">A hands-on team focused on results, not volume.</p>
    </div>

    <div class="team-accordion__gallery" data-team-gallery>
      {members.map((member, idx) => (
        <div
          class={`team-accordion__card ${idx === 0 ? "is-active" : ""}`}
          data-team-card
          data-index={idx}
          role="button"
          tabindex="0"
          aria-pressed={idx === 0 ? "true" : "false"}
          aria-label={`${member.name}, ${member.role}`}
        >
          <img
            src={member.image}
            alt=""
            class="team-accordion__img"
            width="640"
            height="800"
            loading={idx === 0 ? "eager" : "lazy"}
            decoding="async"
          />
          <div class="team-accordion__shade" aria-hidden="true"></div>

          <div class="team-accordion__meta">
            <span class="team-accordion__name">{member.name}</span>
            <span class="team-accordion__role">{member.role}</span>
            <a href="/about/" class="team-accordion__link">Meet the team</a>
          </div>

          <span class="team-accordion__vertical" aria-hidden="true">{member.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initTeamAccordion() {
    const gallery = document.querySelector("[data-team-gallery]");
    if (!gallery || gallery instanceof HTMLElement === false) return;
    if (gallery.dataset.ready === "true") return;
    gallery.dataset.ready = "true";

    const cards = Array.from(gallery.querySelectorAll("[data-team-card]"));

    function activate(index: number) {
      cards.forEach((card, idx) => {
        const isActive = idx === index;
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-pressed", isActive ? "true" : "false");
        const link = card.querySelector(".team-accordion__link");
        if (link instanceof HTMLElement) {
          link.tabIndex = isActive ? 0 : -1;
        }
      });
    }

    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest(".team-accordion__link")) {
          return;
        }
        const index = Number(card.getAttribute("data-index") || "0");
        activate(index);
      });

      card.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (event.key !== "Enter" && event.key !== " ") return;
        if (event.target instanceof Element && event.target.closest(".team-accordion__link")) {
          return;
        }
        event.preventDefault();
        const index = Number(card.getAttribute("data-index") || "0");
        activate(index);
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTeamAccordion);
  } else {
    initTeamAccordion();
  }
</script>

<style>
  .team-accordion {
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
    background: #ffffff;
  }

  .team-accordion__inner {
    max-width: 1120px;
  }

  .team-accordion__header {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 2.75rem;
  }

  .team-accordion__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.4rem 0.95rem;
    border: 1px solid #bae6fd;
    border-radius: 9999px;
    background: #ffffff;
    color: #0369a1;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    margin-bottom: 1.1rem;
  }

  .team-accordion__title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    color: #0f172a;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 0.85rem;
  }

  .team-accordion__subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
    color: #64748b;
    margin: 0;
  }

  .team-accordion__gallery {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    height: clamp(360px, 48vw, 480px);
  }

  .team-accordion__card {
    position: relative;
    flex: 0 0 72px;
    border: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    cursor: pointer;
    border-radius: 24px;
    background: #0f172a;
    color: #ffffff;
    text-align: left;
    outline: none;
    transition: flex 0.45s ease;
  }

  .team-accordion__card:focus-visible {
    box-shadow: 0 0 0 3px #ffffff, 0 0 0 6px #0ea5e9;
  }

  .team-accordion__card.is-active {
    flex: 1 1 auto;
    cursor: default;
  }

  .team-accordion__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: filter 0.35s ease;
    filter: grayscale(25%);
  }

  .team-accordion__card.is-active .team-accordion__img {
    filter: grayscale(0%);
  }

  .team-accordion__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.82) 0%,
      rgba(15, 23, 42, 0.28) 42%,
      rgba(15, 23, 42, 0.12) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  .team-accordion__meta {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.4rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .team-accordion__card.is-active .team-accordion__meta {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: 0.12s;
  }

  .team-accordion__name {
    font-family: var(--font-sans);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1.2;
  }

  .team-accordion__role {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.78);
  }

  .team-accordion__link {
    margin-top: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: #7dd3fc;
    text-decoration: none;
  }

  .team-accordion__link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .team-accordion__vertical {
    position: absolute;
    left: 50%;
    bottom: 1.35rem;
    z-index: 2;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #ffffff;
    white-space: nowrap;
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .team-accordion__card.is-active .team-accordion__vertical {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 860px) {
    .team-accordion__gallery {
      height: 340px;
      gap: 0.55rem;
    }

    .team-accordion__card {
      flex-basis: 56px;
    }

    .team-accordion__meta {
      left: 1.1rem;
      right: 1.1rem;
      bottom: 1.1rem;
    }
  }

  @media (max-width: 640px) {
    .team-accordion__header {
      margin-bottom: 2rem;
    }

    .team-accordion__gallery {
      height: 300px;
    }

    .team-accordion__card {
      flex-basis: 48px;
    }

    .team-accordion__name {
      font-size: 1.15rem;
    }

    .team-accordion__role {
      font-size: 0.85rem;
    }

    .team-accordion__vertical {
      font-size: 0.72rem;
      bottom: 1rem;
    }
  }
</style>
