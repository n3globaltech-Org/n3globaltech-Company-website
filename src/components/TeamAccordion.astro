---
const members = [
  {
    name: "Nibras",
    role: "Founder & CEO",
    image: "/team/nibras.webp",
  },
  {
    name: "Nabeel",
    role: "Co-founder & CTO",
    image: "/team/nabeel.webp",
  },
  {
    name: "Nafi",
    role: "Co-founder",
    image: "/team/nafi.webp",
  },
  {
    name: "Farseen",
    role: "Co-founder",
    image: "/team/farseen.webp",
  },
];
---

<section class="team-accordion" id="team" aria-labelledby="team-accordion-title">
  <div class="container team-accordion__inner">
    <div class="team-accordion__header">
      <div class="team-accordion__kicker">
        <span class="team-accordion__kicker-sq"></span> OUR TEAM
      </div>
      <h2 class="team-accordion__title" id="team-accordion-title">The minds behind N3</h2>
      <p class="team-accordion__subtitle">A hands-on team focused on results, not volume.</p>
    </div>

    <div class="team-accordion__gallery" data-team-gallery>
      {members.map((member, idx) => (
        <div
          class={`team-accordion__card ${idx === 0 ? "is-active" : ""} ${idx >= 2 ? "team-accordion__card--desktop-only" : ""}`}
          data-team-card
          data-index={idx}
          role="button"
          tabindex="0"
          aria-pressed={idx === 0 ? "true" : "false"}
          aria-label={`${member.name}, ${member.role}`}
        >
          <img
            src={member.image}
            alt=""
            class="team-accordion__img"
            width="640"
            height="800"
            loading={idx === 0 ? "eager" : "lazy"}
            decoding="async"
          />
          <div class="team-accordion__shade" aria-hidden="true"></div>

          <div class="team-accordion__meta">
            <span class="team-accordion__name">{member.name}</span>
            <span class="team-accordion__role">{member.role}</span>
            <a href="/about/" class="team-accordion__link">Meet the team</a>
          </div>

          <span class="team-accordion__vertical" aria-hidden="true">{member.name}</span>
        </div>
      ))}

      <a
        href="/about/"
        class="team-accordion__card team-accordion__card--about team-accordion__card--mobile-only"
        aria-label="Meet the full team on the About page"
      >
        <div class="team-accordion__about-bg" aria-hidden="true"></div>
        <span class="team-accordion__vertical">Meet the team</span>
      </a>
    </div>
  </div>
</section>

<script>
  function initTeamAccordion() {
    const gallery = document.querySelector("[data-team-gallery]");
    if (!(gallery instanceof HTMLElement)) return;
    if (gallery.dataset.ready === "true") return;
    gallery.dataset.ready = "true";

    const cards = Array.from(gallery.querySelectorAll("[data-team-card]"));
    const mobileQuery = window.matchMedia("(max-width: 860px)");

    function visibleCards() {
      return cards.filter((card) => {
        if (!(card instanceof HTMLElement)) return false;
        return window.getComputedStyle(card).display !== "none";
      });
    }

    function activate(index: number) {
      const next = visibleCards();
      const allowed = new Set(next.map((card) => Number(card.getAttribute("data-index") || "0")));
      if (!allowed.has(index)) {
        index = Number(next[0]?.getAttribute("data-index") || "0");
      }

      cards.forEach((card) => {
        const cardIndex = Number(card.getAttribute("data-index") || "0");
        const isActive = cardIndex === index;
        card.classList.toggle("is-active", isActive);
        card.setAttribute("aria-pressed", isActive ? "true" : "false");
      });
    }

    function syncForViewport() {
      const active = cards.find((card) => card.classList.contains("is-active"));
      const activeIndex = Number(active?.getAttribute("data-index") || "0");
      activate(activeIndex);
    }

    cards.forEach((card) => {
      card.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && target.closest(".team-accordion__link")) {
          return;
        }
        const index = Number(card.getAttribute("data-index") || "0");
        activate(index);
      });

      card.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent)) return;
        if (event.key !== "Enter" && event.key !== " ") return;
        if (event.target instanceof Element && event.target.closest(".team-accordion__link")) {
          return;
        }
        event.preventDefault();
        const index = Number(card.getAttribute("data-index") || "0");
        activate(index);
      });
    });

    if (typeof mobileQuery.addEventListener === "function") {
      mobileQuery.addEventListener("change", syncForViewport);
    } else {
      mobileQuery.addListener(syncForViewport);
    }

    syncForViewport();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTeamAccordion);
  } else {
    initTeamAccordion();
  }
</script>

<style>
  /* Temporarily hidden on desktop until updated photos are ready */
  @media (min-width: 861px) {
    .team-accordion {
      display: none !important;
    }
  }

  .team-accordion {
    padding: 4.5rem 0 3.5rem;
    background: #ffffff;
  }

  .team-accordion__inner {
    width: 100%;
  }

  .team-accordion__header {
    margin: 0 0 2.5rem;
  }

  .team-accordion__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: var(--label-sm);
    font-weight: 500;
    letter-spacing: 0.11em;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }

  .team-accordion__kicker-sq {
    width: 6.5px;
    height: 6.5px;
    background-color: #0284c7;
    display: inline-block;
    border-radius: 1px;
  }

  .team-accordion__title {
    font-family: var(--font-sans);
    font-size: clamp(1.85rem, 2.75vw, 2.75rem);
    font-weight: 400;
    color: #0f172a;
    line-height: 1.25;
    letter-spacing: -0.035em;
    margin: 0 0 0.75rem;
    max-width: 40rem;
  }

  .team-accordion__subtitle {
    font-family: var(--font-sans);
    font-size: var(--body-md);
    font-weight: 400;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0;
    max-width: 36rem;
  }

  .team-accordion__gallery {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    height: clamp(360px, 48vw, 480px);
  }

  .team-accordion__card {
    position: relative;
    flex: 0 0 72px;
    border: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    cursor: pointer;
    border-radius: 24px;
    background: #0f172a;
    color: #ffffff;
    text-align: left;
    outline: none;
    text-decoration: none;
    transition: flex 0.45s ease;
  }

  .team-accordion__card:focus-visible {
    box-shadow: 0 0 0 3px #ffffff, 0 0 0 6px #0ea5e9;
  }

  .team-accordion__card.is-active {
    flex: 1 1 auto;
    cursor: default;
  }

  .team-accordion__card--mobile-only {
    display: none;
  }

  .team-accordion__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: filter 0.35s ease;
    filter: grayscale(25%);
  }

  .team-accordion__card.is-active .team-accordion__img {
    filter: grayscale(0%);
  }

  .team-accordion__shade,
  .team-accordion__about-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .team-accordion__shade {
    background: linear-gradient(
      to top,
      rgba(15, 23, 42, 0.82) 0%,
      rgba(15, 23, 42, 0.28) 42%,
      rgba(15, 23, 42, 0.12) 100%
    );
  }

  .team-accordion__about-bg {
    background: linear-gradient(180deg, #0369a1 0%, #0f172a 100%);
  }

  .team-accordion__meta {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    bottom: 1.4rem;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .team-accordion__card.is-active .team-accordion__meta {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    transition-delay: 0.12s;
  }

  .team-accordion__name {
    font-family: var(--font-sans);
    font-size: var(--heading-sm);
    font-weight: 450;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .team-accordion__role {
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.78);
  }

  .team-accordion__link {
    margin-top: 0.45rem;
    font-family: var(--font-sans);
    font-size: var(--body-sm);
    font-weight: 500;
    color: #7dd3fc;
    text-decoration: none;
  }

  .team-accordion__link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .team-accordion__vertical {
    position: absolute;
    left: 50%;
    bottom: 1.35rem;
    z-index: 2;
    writing-mode: vertical-rl;
    transform: translateX(-50%) rotate(180deg);
    font-family: var(--font-sans);
    font-size: var(--label-sm);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #ffffff;
    white-space: nowrap;
    opacity: 1;
    transition: opacity 0.2s ease;
  }

  .team-accordion__card.is-active .team-accordion__vertical {
    opacity: 0;
    pointer-events: none;
  }

  .team-accordion__card--about .team-accordion__vertical {
    opacity: 1;
    color: #e0f2fe;
  }

  .team-accordion__card--about:hover {
    transform: none;
  }

  @media (max-width: 860px) {
    .team-accordion__gallery {
      height: 340px;
      gap: 0.55rem;
    }

    .team-accordion__card {
      flex-basis: 58px;
    }

    .team-accordion__card--desktop-only {
      display: none;
    }

    .team-accordion__card--mobile-only {
      display: block;
      flex: 0 0 58px;
      cursor: pointer;
    }

    .team-accordion__meta .team-accordion__link {
      display: none;
    }

    .team-accordion__meta {
      left: 1.1rem;
      right: 1.1rem;
      bottom: 1.1rem;
    }
  }

  @media (max-width: 640px) {
    .team-accordion__header {
      margin-bottom: 2rem;
    }

    .team-accordion__gallery {
      height: 300px;
    }

    .team-accordion__card,
    .team-accordion__card--mobile-only {
      flex-basis: 52px;
    }

    .team-accordion__name {
      font-size: 1.15rem;
    }

    .team-accordion__role {
      font-size: var(--body-sm);
    }

    .team-accordion__vertical {
      font-size: 0.7rem;
      bottom: 1rem;
    }
  }
</style>
