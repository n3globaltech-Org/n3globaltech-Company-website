---
interface Props {
  showTitle?: boolean;
  linkToContact?: boolean;
}

const { showTitle = true, linkToContact = false } = Astro.props;

const ctaText = linkToContact
  ? "START A PROJECT • GET IN TOUCH •"
  : "EXPLORE OUR SERVICES • EXPLORE •";
---

<section class="section services-stacked-section" id="what-we-do-cards">
  <div class="container">
    {showTitle && (
      <div class="stacked-section-header">
        <h2 class="stacked-section-title">
          Our <span class="highlight-blue">Services</span>
        </h2>
      </div>
    )}

    <div class="stacked-cards-container">
      <!-- CARD 1: Technology & Engineering -->
      <article class="stacked-card card-purple-magenta" id="card-tech">
        <div class="stacked-card__inner">
          <div class="stacked-card__visual">
            <div class="visual-hero-stage">
              <img
                src="/service1.webp"
                alt="Technology & Engineering showcase"
                class="visual-hero-img"
                loading="lazy"
              />
            </div>
          </div>

          <div class="stacked-card__content">
            <h3 class="stacked-card__title">Technology &amp; Engineering</h3>

            <div class="stacked-card__chips">
              <span class="tech-chip">Web Development</span>
              <span class="tech-chip">Mobile Development</span>
              <span class="tech-chip">Cloud Solutions</span>
              <span class="tech-chip">Business &amp; AI Automation</span>
            </div>

            <p class="stacked-card__desc">
              We develop custom software and web/mobile platforms that stand out
              to international standards, ensuring peak quality and performance.
              Using cutting-edge technologies, we create platforms that are
              visually striking and highly functional.
            </p>

            <div class="stacked-card__footer">
              <a
                href={linkToContact ? "/contact?service=tech" : "/services#card-tech"}
                class="circular-badge-cta"
                aria-label={linkToContact ? "Start a Technology & Engineering Project" : "Explore Service"}
              >
                <div class="badge-text-ring">
                  <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <path
                      id="circlePath-1-component"
                      d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                      fill="none"></path>
                    <text
                      font-size="11.2"
                      font-weight="500"
                      letter-spacing="1.4"
                      fill="#334155"
                    >
                      <textPath href="#circlePath-1-component" startOffset="0%">
                        {ctaText}
                      </textPath>
                    </text>
                  </svg>
                </div>
                <div class="badge-arrow-icon icon-magenta">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      d="M7 17L17 7M17 7H7M17 7V17"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- CARD 2: Strategy & Consulting -->
      <article class="stacked-card card-electric-blue" id="card-strategy">
        <div class="stacked-card__inner layout-reverse">
          <div class="stacked-card__content">
            <h3 class="stacked-card__title">Strategy &amp; Consulting</h3>

            <div class="stacked-card__chips">
              <span class="tech-chip">Digital Audits</span>
              <span class="tech-chip">Tech Roadmaps</span>
              <span class="tech-chip">Cloud Architecture</span>
              <span class="tech-chip">IT Consulting</span>
              <span class="tech-chip">Growth Strategy</span>
            </div>

            <p class="stacked-card__desc">
              Digital transformation audits, technical roadmaps, and competitive
              benchmarking. We map where your business is, where you need to be,
              and the exact steps to get there — with complete clarity.
            </p>

            <div class="stacked-card__footer">
              <a
                href={linkToContact ? "/contact?service=strategy" : "/services#card-strategy"}
                class="circular-badge-cta"
                aria-label={linkToContact ? "Consult with our Strategy Team" : "Explore Service"}
              >
                <div class="badge-text-ring">
                  <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <path
                      id="circlePath-2-component"
                      d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                      fill="none"></path>
                    <text
                      font-size="11.2"
                      font-weight="500"
                      letter-spacing="1.4"
                      fill="#334155"
                    >
                      <textPath href="#circlePath-2-component" startOffset="0%">
                        {ctaText}
                      </textPath>
                    </text>
                  </svg>
                </div>
                <div class="badge-arrow-icon icon-blue">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      d="M7 17L17 7M17 7H7M17 7V17"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </a>
            </div>
          </div>

          <div class="stacked-card__visual">
            <div class="visual-hero-stage">
              <img
                src="/strategy.webp"
                alt="Strategy & Consulting roadmap"
                class="visual-hero-img"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </article>

      <!-- CARD 3: Branding & Design -->
      <article class="stacked-card card-royal-purple" id="card-brand">
        <div class="stacked-card__inner">
          <div class="stacked-card__visual">
            <div class="visual-hero-stage">
              <img
                src="/brandingg.webp"
                alt="Branding & Design showcase"
                class="visual-hero-img"
                loading="lazy"
              />
            </div>
          </div>

          <div class="stacked-card__content">
            <h3 class="stacked-card__title">Branding &amp; Design</h3>

            <div class="stacked-card__chips">
              <span class="tech-chip">Figma</span>
              <span class="tech-chip">UI/UX Design</span>
              <span class="tech-chip">Brand Identity</span>
              <span class="tech-chip">Logo Systems</span>
              <span class="tech-chip">Design Systems</span>
              <span class="tech-chip">Product Design</span>
            </div>

            <p class="stacked-card__desc">
              Identity systems, UI/UX, custom logo design, and product design.
              Visual languages that are distinctive, consistent, and built to
              scale effortlessly across every digital touchpoint.
            </p>

            <div class="stacked-card__footer">
              <a
                href={linkToContact ? "/contact?service=branding" : "/services#card-brand"}
                class="circular-badge-cta"
                aria-label={linkToContact ? "Start a Brand & Design Project" : "Explore Service"}
              >
                <div class="badge-text-ring">
                  <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <path
                      id="circlePath-3-component"
                      d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                      fill="none"></path>
                    <text
                      font-size="11.2"
                      font-weight="500"
                      letter-spacing="1.4"
                      fill="#334155"
                    >
                      <textPath href="#circlePath-3-component" startOffset="0%">
                        {ctaText}
                      </textPath>
                    </text>
                  </svg>
                </div>
                <div class="badge-arrow-icon icon-purple">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      d="M7 17L17 7M17 7H7M17 7V17"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </a>
            </div>
          </div>
        </div>
      </article>

      <!-- CARD 4: Marketing & Growth -->
      <article class="stacked-card card-sunset-coral" id="card-marketing">
        <div class="stacked-card__inner layout-reverse">
          <div class="stacked-card__content">
            <h3 class="stacked-card__title">Marketing &amp; Growth</h3>

            <div class="stacked-card__chips">
              <span class="tech-chip">SEO &amp; SEM</span>
              <span class="tech-chip">Digital Marketing</span>
              <span class="tech-chip">Social Media</span>
              <span class="tech-chip">Growth Analytics</span>
              <span class="tech-chip">Conversion Strategy</span>
            </div>

            <p class="stacked-card__desc">
              Grow your digital presence with targeted marketing campaigns,
              search engine optimization (SEO), performance marketing, and
              data-driven insights engineered for real ROI.
            </p>

            <div class="stacked-card__footer">
              <a
                href={linkToContact ? "/contact?service=marketing" : "/services#card-marketing"}
                class="circular-badge-cta"
                aria-label={linkToContact ? "Start a Marketing & Growth Campaign" : "Explore Service"}
              >
                <div class="badge-text-ring">
                  <svg viewBox="0 0 100 100" width="100%" height="100%">
                    <path
                      id="circlePath-4-component"
                      d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
                      fill="none"></path>
                    <text
                      font-size="11.2"
                      font-weight="500"
                      letter-spacing="1.4"
                      fill="#334155"
                    >
                      <textPath href="#circlePath-4-component" startOffset="0%">
                        {ctaText}
                      </textPath>
                    </text>
                  </svg>
                </div>
                <div class="badge-arrow-icon icon-coral">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                  >
                    <path
                      d="M7 17L17 7M17 7H7M17 7V17"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>
              </a>
            </div>
          </div>

          <div class="stacked-card__visual">
            <div class="visual-hero-stage">
              <img
                src="/marketing.webp"
                alt="Marketing & Growth showcase"
                class="visual-hero-img"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* ===== STACKED CARDS SCROLL SECTION HEADER & LAYOUT ===== */
  .stacked-section-header {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    text-align: center !important;
    margin: 0 auto 3.2rem auto !important;
    width: 100% !important;
  }

  .stacked-section-title {
    font-family: var(--font-sans) !important;
    font-size: var(--heading-md) !important;
    font-weight: 400 !important;
    color: #0f172a !important;
    line-height: 1.1 !important;
    letter-spacing: -0.03em !important;
    margin: 0 auto !important;
    text-align: center !important;
    display: block !important;
    width: 100% !important;
  }

  .stacked-section-title .highlight-blue {
    color: var(--sky-500) !important;
  }

  .services-stacked-section {
    padding-top: 4rem !important;
    padding-bottom: 4rem !important;
    overflow: visible !important;
    background: #ffffff;
  }

  .services-stacked-section .container {
    max-width: 100% !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding-left: 1.5rem !important;
    padding-right: 1.5rem !important;
    box-sizing: border-box;
  }

  .stacked-cards-container {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 auto;
  }

  .stacked-card {
    position: sticky;
    top: 90px;
    border-radius: 22px;
    overflow: hidden;
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.18),
      0 2px 6px rgba(0, 0, 0, 0.06);
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
    width: 100% !important;
    height: min(715px, calc(100svh - 118px)) !important;
    min-height: 560px !important;
    margin-bottom: 25vh;
    box-sizing: border-box;
  }

  .stacked-card:last-child {
    margin-bottom: 0 !important;
  }

  #card-tech {
    top: 90px;
    z-index: 1;
  }
  #card-strategy {
    top: 90px;
    z-index: 2;
  }
  #card-brand {
    top: 90px;
    z-index: 3;
  }
  #card-marketing {
    top: 90px;
    z-index: 4;
  }

  .card-purple-magenta {
    background: #c66de5;
  }
  .card-electric-blue {
    background: linear-gradient(135deg, #689ff8 0%, #675ae6 100%);
  }
  .card-royal-purple {
    background: #7700b8;
  }
  .card-sunset-coral {
    background: #1e499e;
  }

  .stacked-card__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    height: 100% !important;
    min-height: 0 !important;
    color: #ffffff;
    box-sizing: border-box;
  }

  .stacked-card__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    position: relative;
    overflow: hidden;
    height: 100% !important;
    min-height: 0 !important;
    background: rgba(0, 0, 0, 0.04);
  }

  .visual-hero-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .stacked-card:hover .visual-hero-img {
    transform: scale(1.03);
  }

  .stacked-card__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 5rem 5.5rem;
    height: 100% !important;
    min-height: 0 !important;
    box-sizing: border-box;
    position: relative;
    z-index: 2;
  }

  .stacked-card__title {
    font-family: var(--font-sans);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 450;
    color: #ffffff;
    margin-bottom: 1.5rem;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .stacked-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 3.5rem;
  }

  .tech-chip {
    font-family: var(--font-sans);
    background: rgba(255, 255, 255, 0.94);
    color: #334155;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.6rem 1.4rem;
    border-radius: 24px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease;
  }

  .tech-chip:hover {
    background: #ffffff;
    transform: translateY(-2px);
    color: #0f172a;
  }

  .stacked-card__desc {
    font-family: var(--font-sans);
    font-size: var(--body-lg);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
    margin-bottom: 2.5rem;
    max-width: 660px;
    font-weight: 400;
  }

  .stacked-card__footer {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
  }

  .circular-badge-cta {
    position: relative;
    width: 126px;
    height: 126px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  .circular-badge-cta:hover {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.28);
  }

  .badge-text-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: spinSlow 15s linear infinite;
  }

  .circular-badge-cta:hover .badge-text-ring {
    animation-duration: 6s;
  }

  .badge-arrow-icon {
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease;
  }

  .badge-arrow-icon.icon-magenta {
    color: #db2777;
  }
  .badge-arrow-icon.icon-blue {
    color: #2563eb;
  }
  .badge-arrow-icon.icon-purple {
    color: #9333ea;
  }
  .badge-arrow-icon.icon-coral {
    color: #e11d48;
  }

  .circular-badge-cta:hover .badge-arrow-icon.icon-magenta {
    background: #db2777;
    color: #ffffff !important;
    transform: scale(1.08);
  }
  .circular-badge-cta:hover .badge-arrow-icon.icon-blue {
    background: #2563eb;
    color: #ffffff !important;
    transform: scale(1.08);
  }
  .circular-badge-cta:hover .badge-arrow-icon.icon-purple {
    background: #9333ea;
    color: #ffffff !important;
    transform: scale(1.08);
  }
  .circular-badge-cta:hover .badge-arrow-icon.icon-coral {
    background: #e11d48;
    color: #ffffff !important;
    transform: scale(1.08);
  }

  @keyframes spinSlow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 901px) and (max-height: 820px) {
    .stacked-card__content {
      padding: 2.75rem 3.75rem;
    }

    .stacked-card__title {
      font-size: 2.65rem;
      margin-bottom: 1.15rem;
    }

    .stacked-card__chips {
      gap: 0.6rem;
      margin-bottom: 1.35rem;
    }

    .tech-chip {
      padding: 0.52rem 1.15rem;
      font-size: 0.86rem;
    }

    .stacked-card__desc {
      margin-bottom: 1.25rem;
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .circular-badge-cta {
      width: 82px;
      height: 82px;
    }

    .badge-text-ring svg {
      width: 82px;
      height: 82px;
    }
  }

  @media (max-width: 900px) {
    .services-stacked-section .container {
      padding-left: 0.75rem !important;
      padding-right: 0.75rem !important;
    }

    .stacked-cards-container {
      width: 100% !important;
      padding: 0 !important;
    }

    .stacked-card {
      position: sticky !important;
      top: 75px !important;
      height: 660px !important;
      min-height: 660px !important;
      margin-bottom: 22vh !important;
      border-radius: 24px !important;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.22) !important;
    }

    .stacked-card:last-child {
      margin-bottom: 0 !important;
    }

    .stacked-card__inner,
    .stacked-card__inner.layout-reverse {
      display: flex !important;
      flex-direction: column !important;
      height: 660px !important;
      min-height: 660px !important;
      position: relative !important;
    }

    .stacked-card__visual {
      order: 1 !important;
      height: 290px !important;
      min-height: 290px !important;
      width: 100% !important;
      position: relative !important;
    }

    .visual-hero-stage {
      height: 290px !important;
      min-height: 290px !important;
      width: 100% !important;
    }

    .stacked-card__content {
      order: 2 !important;
      padding: 2.2rem 1.6rem 2.2rem 1.6rem !important;
      height: 370px !important;
      min-height: 370px !important;
      justify-content: flex-start !important;
    }

    .stacked-card__title {
      font-size: clamp(1.35rem, 4.6vw, 1.6rem) !important;
      font-weight: 500 !important;
      margin-bottom: 0.85rem !important;
      line-height: 1.2 !important;
      white-space: nowrap !important;
    }

    .stacked-card__chips {
      gap: 0.5rem !important;
      margin-bottom: 1.25rem !important;
    }

    .tech-chip {
      font-size: 0.72rem !important;
      padding: 0.3rem 0.75rem !important;
      border-radius: 12px !important;
      font-weight: 500 !important;
    }

    .stacked-card__desc {
      font-size: 0.9rem !important;
      line-height: 1.6 !important;
      margin-bottom: 1rem !important;
      color: rgba(255, 255, 255, 0.88) !important;
    }

    .stacked-card__footer {
      position: absolute !important;
      right: 1.25rem !important;
      bottom: 1.25rem !important;
      top: auto !important;
      transform: none !important;
      z-index: 10 !important;
      margin-top: 0 !important;
    }

    .circular-badge-cta {
      width: 82px !important;
      height: 82px !important;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.22) !important;
    }

    .badge-text-ring svg {
      width: 82px !important;
      height: 82px !important;
    }

    .badge-arrow-icon {
      width: 40px !important;
      height: 40px !important;
    }

    .badge-arrow-icon svg {
      width: 20px !important;
      height: 20px !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-text-ring {
      animation: none;
    }

    .visual-hero-img,
    .circular-badge-cta,
    .badge-arrow-icon,
    .tech-chip {
      transition: none;
    }
  }
</style>
