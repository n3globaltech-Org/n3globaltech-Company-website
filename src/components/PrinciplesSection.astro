---
// Why Choose Us Section — Bento Grid Layout with Smooth Infinite Horizontal Marquee for End-to-End Craft and Modern Stack
---

<section class="section why-choose-section" id="why-choose-us">
  <div class="container why-choose__container">
    
    <!-- Section Header matching reference -->
    <div class="why-choose__header">
      <div class="why-choose__header-left">
        <h2 class="why-choose__title">Why Choose Us</h2>
        <div class="why-choose__sep" aria-hidden="true"></div>
        <div class="why-choose__kicker">
          <span class="why-choose__kicker-sq" aria-hidden="true"></span>
          <span class="why-choose__kicker-text">N3 GLOBAL TECH</span>
        </div>
      </div>
    </div>
    <div class="why-choose__divider"></div>

    <!-- 3-Column Bento Grid -->
    <div class="why-choose__grid">
      
      <!-- Column 1: End-to-End Craft & Client Approval -->
      <div class="why-col why-col--left">
        
        <!-- Card 1: End-to-End Craft with Continuous Horizontal Device Marquee -->
        <article class="why-card why-card--craft">
          <div class="craft-visual" aria-label="End-to-End Craft interactive device carousel">
            <div class="craft-track">
              <!-- Group 1 -->
              <div class="craft-group">
                <div class="craft-item">
                  <img 
                    src="/images/why-choose-us/end-craft-tablet.webp" 
                    alt="Tablet Web Application" 
                    class="craft-device craft-device--tablet"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="craft-item">
                  <img 
                    src="/images/why-choose-us/end-craft-mobile.webp" 
                    alt="Mobile Application Screen" 
                    class="craft-device craft-device--mobile"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="craft-item">
                  <img 
                    src="/images/why-choose-us/end-craft-watch.webp" 
                    alt="Smartwatch Interface" 
                    class="craft-device craft-device--watch"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <!-- Group 2 (Duplicate for 100% seamless infinite scroll loop) -->
              <div class="craft-group" aria-hidden="true">
                <div class="craft-item">
                  <img 
                    src="/images/why-choose-us/end-craft-tablet.webp" 
                    alt="" 
                    class="craft-device craft-device--tablet"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="craft-item">
                  <img 
                    src="/images/why-choose-us/end-craft-mobile.webp" 
                    alt="" 
                    class="craft-device craft-device--mobile"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="craft-item">
                  <img 
                    src="/images/why-choose-us/end-craft-watch.webp" 
                    alt="" 
                    class="craft-device craft-device--watch"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </div>

          <div class="why-card__body">
            <h3 class="why-card__title">End-to-End Craft</h3>
            <p class="why-card__desc">
              From wireframes to production deployment, everything is designed & engineered in-house
            </p>
          </div>
        </article>

        <!-- Card 2: Client Approval -->
        <article class="why-card why-card--approval">
          <div class="approval-content">
            <div class="approval-stars" aria-label="5 out of 5 stars rating">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" class="star-icon"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
            </div>
            <h3 class="approval-title">Client Approval</h3>
            <p class="approval-desc">
              Consistently high satisfaction driven by quality execution.
            </p>
          </div>
          <div class="approval-avatar-wrap">
            <img 
              src="/images/why-choose-us/client-approval.webp" 
              alt="Satisfied Partner" 
              class="approval-avatar"
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>

      </div>

      <!-- Column 2: Live Progress & Stat Badges -->
      <div class="why-col why-col--center">
        
        <!-- Card 3: Live Progress (Tall Orange Card) -->
        <article class="why-card why-card--progress">
          <div class="progress-header">
            <h3 class="progress-title">Live Progress</h3>
            <p class="progress-desc">
              Stay updated with real-time visibility into tasks, timelines, and delivery stages.
            </p>
          </div>
          <div class="progress-visual">
            <img 
              src="/images/why-choose-us/live-progress.webp" 
              alt="Live Dashboard Laptop" 
              class="progress-laptop"
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>

        <!-- Two Mini Cards Row -->
        <div class="why-mini-row">
          
          <!-- Mini Card 1: Trusted By Teams -->
          <article class="why-card why-card--mini">
            <h4 class="mini-title">Trusted By<br />Teams</h4>
            <div class="mini-icon-wrap" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <p class="mini-desc">Over forty companies trust N3 Global Tech worldwide.</p>
          </article>

          <!-- Mini Card 2: Measurable Impact -->
          <article class="why-card why-card--mini">
            <h4 class="mini-title">Measurable<br />Impact</h4>
            <div class="mini-icon-wrap" aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
                <polyline points="17 6 23 6 23 12"></polyline>
              </svg>
            </div>
            <p class="mini-desc">Clients get better results after launch.</p>
          </article>

        </div>

      </div>

      <!-- Column 3: Modern Stack & Built To Scale -->
      <div class="why-col why-col--right">
        
        <!-- Card 4: Modern Stack with Continuous Horizontal Marquee -->
        <article class="why-card why-card--stack">
          <div class="stack-header">
            <h3 class="why-card__title">Modern Stack</h3>
            <p class="why-card__desc">
              We use leading tools and platforms to build future-ready websites
            </p>
          </div>

          <!-- White pill container with horizontal scrolling marquee -->
          <div class="stack-pill" aria-label="Modern tech stack logos marquee">
