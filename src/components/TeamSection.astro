---
const founders = [
  {
    name: "Nibras",
    role: "Founder & CEO",
    bio: "Nibras specializes in cloud architecture, infrastructure automation, platform security, and reliability engineering. He designs scalable cloud environments that enable businesses to operate efficiently and confidently at scale.",
    image: "/team/nibras.webp",
    position: "center top",
  },
  {
    name: "Nabeel",
    role: "Co-founder & CTO",
    bio: "Nabeel defines the technical architecture behind N3's platforms and software solutions. His expertise lies in building scalable technology ecosystems that connect applications, infrastructure, and business operations.",
    image: "/team/nabeel.webp",
    position: "center center",
  },
  {
    name: "Nafi",
    role: "Co-founder",
    bio: "Nafi focuses on backend systems, platform engineering, and technology integrations. He ensures solutions are delivered with reliability, scalability, and performance from development through production.",
    image: "/team/nafi.webp",
    position: "center top",
  },
  {
    name: "Ashwal P",
    role: "AI & Intelligent Systems Architect",
    bio: "Ashwal develops AI-powered systems that improve operational efficiency and digital experiences. His work focuses on intelligent automation, AI workflows, and practical applications of emerging technologies that create measurable business outcomes.",
    image: "/team/ashwal.webp",
    position: "center center",
  },
  {
    name: "Mohammed Rafeel",
    role: "Strategy & Client Success Architect",
    bio: "Mohammed works closely with organizations to align business goals with technology initiatives. He leads solution planning, client engagement, and project strategy, helping businesses transform complex requirements into scalable digital solutions.",
    image: "/team/rafeel.webp",
    position: "center top",
  },
];
---

<section class="section team-section">
  <div class="container team-section__container">
    <div class="team-section__header">
      <div class="team-section__kicker">
        <span class="team-section__kicker-sq"></span> OUR TEAM
      </div>
      <h2 class="team-section__title">Creative Team</h2>
    </div>
    <div class="team-section__divider"></div>

    <!-- Featured Spotlight Card -->
    <div class="team-spotlight">
      <div class="team-spotlight__card">
        <div class="team-spotlight__photo-col">
          <img
            id="spotlight-img"
            src={founders[0].image}
            alt={founders[0].name}
            style={founders[0].position ? `object-position: ${founders[0].position};` : undefined}
            class="team-spotlight__photo"
            width="320"
            height="320"
          />
        </div>
        <div class="team-spotlight__info-col">
          <div class="team-spotlight__meta">
            <div>
              <h3 id="spotlight-name" class="team-spotlight__name">{founders[0].name}</h3>
              <p id="spotlight-role" class="team-spotlight__role">{founders[0].role}</p>
            </div>
            
            <!-- Arrow Navigation -->
            <div class="team-spotlight__nav">
              <button type="button" id="team-prev" class="team-nav-btn" aria-label="Previous Team Member">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="15 18 9 12 15 6"></polyline>
                </svg>
              </button>
              <button type="button" id="team-next" class="team-nav-btn" aria-label="Next Team Member">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <div class="team-spotlight__divider"></div>

          <div class="team-spotlight__bio-section">
            <span class="team-spotlight__bio-label">Description</span>
            <p id="spotlight-bio" class="team-spotlight__bio">{founders[0].bio}</p>
          </div>

          <div id="spotlight-counter" class="team-spotlight__counter">(01/05)</div>
        </div>
      </div>
    </div>

    <!-- Thumbnails Grid -->
    <div class="team-thumbnails">
      {founders.map((f, idx) => (
        <button
          type="button"
          class={`team-thumb ${idx === 0 ? 'is-active' : ''}`}
          data-index={idx}
          aria-label={`Select ${f.name}`}
        >
          <img
            src={f.image}
            alt={f.name}
            style={f.position ? `object-position: ${f.position};` : undefined}
            class="team-thumb__img"
            width="200"
            height="200"
            loading="lazy"
          />
          <div class="team-thumb__overlay">
            <span class="team-thumb__name">{f.name}</span>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ teamData: founders }}>
  (function() {
    function initTeamSlider() {
      var currentIndex = 0;

      var imgEl = document.getElementById("spotlight-img");
      var nameEl = document.getElementById("spotlight-name");
      var roleEl = document.getElementById("spotlight-role");
      var bioEl = document.getElementById("spotlight-bio");
      var counterEl = document.getElementById("spotlight-counter");
      var prevBtn = document.getElementById("team-prev");
      var nextBtn = document.getElementById("team-next");
      var thumbs = document.querySelectorAll(".team-thumb");
      var thumbsContainer = document.querySelector(".team-thumbnails");

      function pad2(n) {
        return n < 10 ? "0" + n : String(n);
      }

      function updateSpotlight(index) {
        if (index < 0) index = teamData.length - 1;
        if (index >= teamData.length) index = 0;
        currentIndex = index;

        var data = teamData[currentIndex];
        
        if (imgEl) {
          imgEl.style.opacity = '0.4';
          setTimeout(function() {
            imgEl.src = data.image;
            imgEl.alt = data.name;
            imgEl.style.objectPosition = data.position || 'center center';
            imgEl.style.opacity = '1';
          }, 120);
        }
        if (nameEl) nameEl.textContent = data.name;
        if (roleEl) roleEl.textContent = data.role;
        if (bioEl) bioEl.textContent = data.bio;
        if (counterEl) {
          counterEl.textContent = "(" + pad2(currentIndex + 1) + "/" + pad2(teamData.length) + ")";
        }

        thumbs.forEach(function(thumb, idx) {
          if (idx === currentIndex) {
            thumb.classList.add("is-active");
            if (thumbsContainer && thumbsContainer.scrollWidth > thumbsContainer.clientWidth) {
              var targetLeft = thumb.offsetLeft - (thumbsContainer.clientWidth / 2) + (thumb.clientWidth / 2);
              thumbsContainer.scrollTo({ left: targetLeft, behavior: "smooth" });
            }
          } else {
            thumb.classList.remove("is-active");
          }
        });
      }

      if (prevBtn) prevBtn.addEventListener("click", function(e) { e.preventDefault(); updateSpotlight(currentIndex - 1); });
      if (nextBtn) nextBtn.addEventListener("click", function(e) { e.preventDefault(); updateSpotlight(currentIndex + 1); });

      thumbs.forEach(function(thumb) {
        thumb.addEventListener("click", function(e) {
          e.preventDefault();
          var idx = parseInt(thumb.getAttribute("data-index"), 10);
          updateSpotlight(idx);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTeamSlider);
    } else {
      initTeamSlider();
    }
  })();
</script>

<style>
  .team-section {
    padding: 3.75rem 0;
    background: #ffffff;
  }

  .team-section__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }

  .team-section__title {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: 500;
    color: #0f172a;
    font-family: var(--font-sans);
    margin: 0;
  }

  .team-section__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #64748b;
    text-transform: uppercase;
  }

  .team-section__kicker-sq {
    width: 6.5px;
    height: 6.5px;
    background-color: #0284c7;
    display: inline-block;
    border-radius: 1px;
  }

  .team-section__divider {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
    margin-bottom: 2rem;
  }

  /* Spotlight Card */
  .team-spotlight {
    margin-bottom: 2rem;
  }

  .team-spotlight__card {
    background: #f8fafc;
    border-radius: 20px;
    padding: 2.5rem;
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    align-items: stretch;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    position: relative;
    border: 1px solid #f1f5f9;
  }

  .team-spotlight__photo-col {
    width: 100%;
    height: 280px;
    border-radius: 14px;
    overflow: hidden;
    background: #e2e8f0;
  }

  .team-spotlight__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.2s ease;
  }

  .team-spotlight__info-col {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .team-spotlight__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .team-spotlight__name {
    font-size: 1.75rem;
    font-weight: 500;
    color: #0f172a;
    margin: 0 0 0.25rem 0;
    font-family: var(--font-sans);
  }

  .team-spotlight__role {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0;
    font-weight: 500;
  }

  .team-spotlight__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .team-nav-btn {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #0284c7;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25 ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .team-nav-btn:hover {
    background: #0284c7;
    color: #ffffff;
    border-color: #0284c7;
    transform: translateY(-1px);
  }

  .team-spotlight__divider {
    width: 100%;
    height: 1px;
    background: #e2e8f0;
    margin: 1.75rem 0;
  }

  .team-spotlight__bio-section {
    flex: 1;
  }

  .team-spotlight__bio-label {
    font-size: 0.85rem;
    font-weight: 500;
    color: #0f172a;
    display: block;
    margin-bottom: 0.5rem;
  }

  .team-spotlight__bio {
    font-size: 1rem;
    line-height: 1.6;
    color: #475569;
    margin: 0;
  }

  .team-spotlight__counter {
    font-size: 0.85rem;
    color: #94a3b8;
    align-self: flex-end;
    font-weight: 500;
    margin-top: 1rem;
  }

  /* Thumbnails Grid */
  .team-thumbnails {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1rem;
  }

  .team-thumb {
    border: none;
    background: #e2e8f0;
    padding: 0;
    cursor: pointer;
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    height: 220px;
    transition: all 0.3s ease;
    outline: none;
  }

  .team-thumb__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(70%);
    opacity: 0.75;
    transition: all 0.3s ease;
  }

  .team-thumb__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.8) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding: 0.85rem 1rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .team-thumb__name {
    color: #ffffff;
    font-weight: 500;
    font-size: 0.85rem;
    font-family: var(--font-sans);
  }

  .team-thumb:hover .team-thumb__img {
    filter: grayscale(20%);
    opacity: 0.9;
  }

  .team-thumb.is-active .team-thumb__img {
    filter: grayscale(0%);
    opacity: 1;
    transform: scale(1.02);
  }

  .team-thumb:hover .team-thumb__overlay,
  .team-thumb.is-active .team-thumb__overlay {
    opacity: 1;
  }

  /* Active glow effect matching reference */
  .team-thumb.is-active::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(2, 132, 199, 0.7) 0%, rgba(2, 132, 199, 0.3) 35%, transparent 65%);
    pointer-events: none;
    z-index: 1;
  }

  .team-thumb.is-active {
    box-shadow: 0 10px 30px rgba(2, 132, 199, 0.3);
  }

  @media (max-width: 1100px) {
    .team-thumbnails {
      grid-template-columns: repeat(3, 1fr);
    }
    .team-thumb {
      height: 240px;
    }
  }

  @media (max-width: 900px) {
    .team-spotlight__card {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding: 1.75rem;
    }
    .team-spotlight__photo-col {
      height: 280px;
    }
    .team-thumbnails {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
    .team-thumb {
      height: 200px;
    }
  }

  @media (max-width: 640px) {
    .team-section {
      padding: 2.5rem 0;
      overflow-x: clip;
    }
    .team-section__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      margin-bottom: 0.75rem;
    }
    .team-section__title {
      font-size: 1.85rem;
    }
    .team-section__divider {
      margin-bottom: 1.25rem;
    }
    .team-spotlight__card {
      padding: 1rem;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .team-spotlight__photo-col {
      height: 280px;
      border-radius: 12px;
      margin-top: 0;
    }
    .team-spotlight__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .team-spotlight__name {
      font-size: 1.4rem;
    }
    .team-spotlight__role {
      font-size: 0.88rem;
    }
    .team-spotlight__divider {
      margin: 1rem 0;
    }
    .team-spotlight__bio {
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .team-thumbnails {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 0.75rem;
      padding: 0.25rem 0 0.75rem 0;
      margin-right: -1.5rem;
      padding-right: 1.5rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .team-thumbnails::-webkit-scrollbar {
      display: none;
    }
    .team-thumb {
      flex: 0 0 120px;
      height: 155px;
      scroll-snap-align: start;
      border-radius: 10px;
    }
  }
</style>
