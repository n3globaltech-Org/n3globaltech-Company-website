---
// ServicesHero.astro - Google Company-Info inspired Hero Section for Services page
---

<section class="company-hero" aria-labelledby="company-hero-heading">
  <!-- Top Full-Bleed Media Collage Banner -->
  <div class="company-hero__media">
    <div class="company-hero__media-inner">
      <img
        src="/images/services-hero-collage.webp"
        alt="N3 Global Tech team, innovations, and technology collage"
        class="company-hero__image"
        width="2172"
        height="724"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- Google-Style Mission Statement with 4 Colored Accent Words -->
  <div class="company-hero__statement">
    <h1 id="company-hero-heading" class="company-hero__title">
      Our mission is to <span class="accent-blue">build</span> technology that makes business <span class="accent-red">simpler</span>, <span class="accent-green">smarter</span>, and <span class="accent-amber">more accessible</span>.
    </h1>
  </div>
</section>

<style>
  .company-hero {
    width: 100%;
    background-color: #ffffff;
    padding-top: calc(68px + 1.75rem);
    padding-bottom: 2.5rem;
    position: relative;
  }

  /* Top Media Collage Banner */
  .company-hero__media {
    width: 100%;
    padding: 0 1.25rem;
    display: flex;
    justify-content: center;
  }

  .company-hero__media-inner {
    max-width: 1400px;
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
  }

  .company-hero__image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  /* Google-Style Mission Statement */
  .company-hero__statement {
    max-width: 1080px;
    margin: 3.75rem auto 2.5rem;
    padding: 0 1.5rem;
    text-align: center;
  }

  .company-hero__title {
    font-family: 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: clamp(2.25rem, 4.4vw, 3.85rem);
    font-weight: 400;
    line-height: 1.24;
    letter-spacing: -0.025em;
    color: #202124;
    margin: 0;
  }

  /* Google Brand Accent Colors */
  .accent-blue {
    color: #4285f4;
    font-weight: 450;
  }

  .accent-red {
    color: #ea4335;
    font-weight: 450;
  }

  .accent-green {
    color: #34a853;
    font-weight: 450;
  }

  .accent-amber {
    color: #e37400;
    font-weight: 450;
  }

  /* Responsive Styling */
  @media (max-width: 1024px) and (min-width: 641px) {
    .company-hero__statement {
      margin: 2.75rem auto 2rem;
    }
  }

  @media (max-width: 640px) {
    .company-hero {
      padding-top: calc(68px + 1rem);
      padding-bottom: 1.5rem;
    }

    .company-hero__media {
      padding: 0 0.75rem;
    }

    .company-hero__media-inner {
      border-radius: 12px;
    }

    .company-hero__statement {
      margin: 2.25rem auto 1.5rem;
      padding: 0 1.125rem;
    }
  }
</style>
