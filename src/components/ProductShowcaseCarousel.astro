---
export interface ShowcaseItem {
  id: string;
  category: string;
  title: string;
  titleColor?: string;
  desc: string;
  author?: {
    name: string;
    role: string;
  };
  buttonText?: string;
  link?: string;
  bgColor: string;
  mediaType: 'image' | 'video';
  mediaSrc: string;
  mediaAlt?: string;
}

interface Props {
  items: ShowcaseItem[];
}

const { items } = Astro.props;
---

<section class="showcase-section" id="showcase" aria-label="Featured Products Showcase">
  <div class="showcase-track-container" id="showcaseTrackContainer">
    <div class="showcase-track" id="showcaseTrack" role="region" aria-label="Product Showcase Carousel" tabindex="0">
      {items.map((item, index) => (
        <article class="showcase-slide" data-index={index}>
          <!-- Content Box -->
          <div class="showcase-card__content" style={`background-color: ${item.bgColor};`}>
            <div class="showcase-card__top">
              <span class="showcase-card__category">{item.category}</span>
              <h2 class="showcase-card__title" style={item.titleColor ? `color: ${item.titleColor};` : undefined}>
                {item.title}
              </h2>
              <p class="showcase-card__desc">{item.desc}</p>
            </div>

            <div class="showcase-card__bottom">
              {item.author && (
                <div class="showcase-card__author">
                  <span class="author-name">{item.author.name}</span>
                  <span class="author-role">{item.author.role}</span>
                </div>
              )}
              <a href={item.link || '#'} class="showcase-card__btn">
                <span>{item.buttonText || 'Read more'}</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>

          <!-- Media Box -->
          <div class="showcase-card__media">
            {item.mediaType === 'video' ? (
              <video
                src={item.mediaSrc}
                class="showcase-media__video"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                aria-label={item.mediaAlt || item.title}
              ></video>
            ) : (
              <img
                src={item.mediaSrc}
                alt={item.mediaAlt || item.title}
                class="showcase-media__img"
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            )}
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Carousel Controls (Left aligned with padding) -->
  <div class="showcase-controls-wrapper">
    <div class="showcase-controls">
      <div class="showcase-nav-btns">
        <button
          type="button"
          class="showcase-nav-btn prev-btn"
          id="showcasePrevBtn"
          aria-label="Previous slide"
          disabled
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="showcase-nav-btn next-btn"
          id="showcaseNextBtn"
          aria-label="Next slide"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

      <!-- Slider progress bar -->
      <div class="showcase-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="showcase-progress-thumb" id="showcaseProgressThumb"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase-section {
    width: 100%;
    position: relative;
    padding: 3rem 0 3.5rem 0;
    background: #ffffff;
    overflow: hidden;
  }

  /* Track Container: aligns initial card with container gutter */
  .showcase-track-container {
    width: 100%;
    position: relative;
  }

  .showcase-track {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    padding: 0 max(1.5rem, calc((100vw - 1240px) / 2));
  }

  .showcase-track::-webkit-scrollbar {
    display: none;
  }

  /* Each slide contains Content Box + Media Box */
  .showcase-slide {
    flex: 0 0 auto;
    display: flex;
    align-items: stretch;
    gap: 1rem;
    scroll-snap-align: start;
    scroll-snap-stop: normal;
  }

  /* Desktop View Dimensions */
  @media (min-width: 901px) {
    .showcase-slide {
      height: 520px;
    }

    .showcase-card__content {
      width: 390px;
      flex: 0 0 390px;
      height: 520px;
      border-radius: 28px;
      padding: 2.5rem 2.25rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .showcase-card__media {
      width: 740px;
      flex: 0 0 740px;
      height: 520px;
      border-radius: 28px;
      overflow: hidden;
      background: #f1f3f4;
      position: relative;
    }
  }

  /* Typography and Details */
  .showcase-card__category {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: #444746;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .showcase-card__title {
    font-family: var(--font-sans);
    font-size: clamp(1.65rem, 2.2vw, 2.05rem);
    font-weight: 450;
    line-height: 1.22;
    letter-spacing: -0.025em;
    margin: 0 0 1rem 0;
  }

  .showcase-card__desc {
    font-family: var(--font-sans);
    font-size: 0.975rem;
    line-height: 1.5;
    color: #444746;
    margin: 0;
    max-width: 95%;
  }

  .showcase-card__bottom {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .showcase-card__author {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .author-name {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: #1f1f1f;
  }

  .author-role {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #444746;
  }

  /* Pill Button */
  .showcase-card__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1.45rem;
    border-radius: 9999px;
    border: 1px solid #747775;
    background: transparent;
    color: #1f1f1f;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .showcase-card__btn:hover {
    background: rgba(0, 0, 0, 0.05);
    border-color: #1f1f1f;
    color: #000000;
  }

  .showcase-card__btn svg {
    transition: transform 0.2s ease;
  }

  .showcase-card__btn:hover svg {
    transform: translateX(3px);
  }

  /* Media styling */
  .showcase-media__video,
  .showcase-media__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Controls Section */
  .showcase-controls-wrapper {
    max-width: 1240px;
    margin: 1.75rem auto 0 auto;
    padding: 0 1.5rem;
  }

  .showcase-controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .showcase-nav-btns {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .showcase-nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid #dadce0;
    background: #ffffff;
    color: #1f1f1f;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
  }

  .showcase-nav-btn:hover:not(:disabled) {
    background: #f1f3f4;
    border-color: #bdc1c6;
  }

  .showcase-nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  /* Progress Line */
  .showcase-progress-bar {
    width: 180px;
    height: 3px;
    background: #e0e2ec;
    border-radius: 9999px;
    position: relative;
    overflow: hidden;
  }

  .showcase-progress-thumb {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 33.333%;
    background: #1f1f1f;
    border-radius: 9999px;
    transition: transform 0.15s ease-out;
  }

  /* Mobile & Tablet Styles matching Google reference (Both sections have identical equal height) */
  @media (max-width: 900px) {
    .showcase-section {
      padding: 2rem 0 2.5rem 0;
    }

    .showcase-slide {
      flex-direction: column;
      width: 86vw;
      max-width: 430px;
      gap: 0.75rem;
    }

    .showcase-card__media {
      width: 100%;
      height: 255px;
      flex: 0 0 255px;
      border-radius: 24px;
      overflow: hidden;
      order: 1; /* Media on top matching screenshot */
    }

    .showcase-card__content {
      width: 100%;
      height: 406px;
      flex: 0 0 406px;
      border-radius: 24px;
      padding: 2rem 1.75rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      order: 2; /* Content on bottom matching screenshot */
      box-sizing: border-box;
    }

    .showcase-card__title {
      font-size: 1.65rem;
      line-height: 1.22;
      letter-spacing: -0.02em;
    }

    .showcase-card__bottom {
      margin-top: auto;
    }

    .showcase-progress-bar {
      width: 140px;
    }
  }

  @media (max-width: 480px) {
    .showcase-slide {
      width: 88vw;
    }

    .showcase-card__media {
      height: 250px;
      flex: 0 0 250px;
    }

    .showcase-card__content {
      height: 406px;
      flex: 0 0 406px;
      padding: 1.75rem 1.5rem;
    }
  }
</style>

<script>
  function initShowcaseCarousel() {
    const track = document.getElementById('showcaseTrack');
    const prevBtn = document.getElementById('showcasePrevBtn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('showcaseNextBtn') as HTMLButtonElement | null;
    const thumb = document.getElementById('showcaseProgressThumb');

    if (!track || !thumb || !prevBtn || !nextBtn) return;

    const slides = track.querySelectorAll('.showcase-slide');
    const totalSlides = slides.length;
    if (totalSlides === 0) return;

    const thumbWidthPercent = 100 / totalSlides;
    thumb.style.width = `${thumbWidthPercent}%`;

    function updateProgress() {
      if (!track || !thumb || !prevBtn || !nextBtn) return;

      const scrollLeft = track.scrollLeft;
      const maxScroll = track.scrollWidth - track.clientWidth;

      if (maxScroll <= 0) {
        thumb.style.transform = 'translateX(0%)';
        prevBtn.disabled = true;
        nextBtn.disabled = true;
        return;
      }

      const ratio = Math.max(0, Math.min(1, scrollLeft / maxScroll));
      const maxTranslatePercent = (totalSlides - 1) * 100;
      const translatePercent = ratio * maxTranslatePercent;
      thumb.style.transform = `translateX(${translatePercent}%)`;

      // Update button disabled states
      prevBtn.disabled = scrollLeft <= 5;
      nextBtn.disabled = scrollLeft >= maxScroll - 5;
    }

    function scrollToIndex(index: number) {
      if (!track) return;
      const targetSlide = slides[index] as HTMLElement | undefined;
      if (targetSlide) {
        const trackRect = track.getBoundingClientRect();
        const slideRect = targetSlide.getBoundingClientRect();
        const currentScroll = track.scrollLeft;
        const targetScroll = currentScroll + (slideRect.left - trackRect.left);

        track.scrollTo({
          left: targetScroll,
          behavior: 'smooth',
        });
      }
    }

    function getCurrentIndex(): number {
      if (!track) return 0;
      let closestIdx = 0;
      let minDiff = Infinity;
      const trackLeft = track.getBoundingClientRect().left;

      slides.forEach((slide, i) => {
        const rect = slide.getBoundingClientRect();
        const diff = Math.abs(rect.left - trackLeft);
        if (diff < minDiff) {
          minDiff = diff;
          closestIdx = i;
        }
      });

      return closestIdx;
    }

    prevBtn.addEventListener('click', () => {
      const current = getCurrentIndex();
      if (current > 0) {
        scrollToIndex(current - 1);
      }
    });

    nextBtn.addEventListener('click', () => {
      const current = getCurrentIndex();
      if (current < totalSlides - 1) {
        scrollToIndex(current + 1);
      }
    });

    track.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });

    // Initial state
    updateProgress();
  }

  // Initialize on load and on Astro page swaps if view transitions are used
  document.addEventListener('DOMContentLoaded', initShowcaseCarousel);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initShowcaseCarousel();
  }
</script>
